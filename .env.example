# Copy to .env and adjust. Loaded via python-dotenv / pydantic-settings.

# Server
EXPO_HOST=127.0.0.1
EXPO_PORT=8090
# Comma-separated allowed browser origins (CORS). Add your company host here
# when serving to multiple users, e.g. http://engineering-ai.company.local:8090
# EXPO_CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090

# Database (SQLite by default; switch to Postgres for multi-user production)
# EXPO_DATABASE_URL=sqlite:///data/expo.db
# EXPO_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/expo

# Data directory
EXPO_DATA_DIR=data

# Vision model (drawings / screenshots / scanned pages)
# EXPO_VISION_MODEL=qwen2.5vl:32b    # 32b = higher accuracy (needs ~20GB+ VRAM); use qwen2.5vl:7b for lighter machines
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Large-model reliability (matters for the 32B vision model) ---
# Keep the vision model resident in Ollama between page calls (avoids reload
# thrash, which can make the runner briefly refuse connections). e.g. 30m, 1h, -1 (forever)
# EXPO_KEEP_ALIVE=5m
# How many times to retry a vision call while the big model is still loading.
# EXPO_VISION_RETRIES=3
#
# ALSO set this on the machine that runs Ollama (system/user env var), so the
# embedding model stays warm too, then restart Ollama:
#   OLLAMA_KEEP_ALIVE=30m
# Optional, only if you have the memory to hold vision + embeddings at once:
#   OLLAMA_MAX_LOADED_MODELS=2

# CAD (DWG) support: path to the free ODA File Converter.
# DXF files work WITHOUT it; only DWG needs conversion.
# EXPO_ODA_CONVERTER=C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
