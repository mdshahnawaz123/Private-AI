# Copy to .env and adjust. Loaded via python-dotenv / pydantic-settings.

# Server
EXPO_HOST=127.0.0.1
EXPO_PORT=8080
# Comma-separated allowed browser origins (CORS). Add your company host here
# when serving to multiple users, e.g. http://engineering-ai.company.local:8080
# EXPO_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Database (SQLite by default; switch to Postgres for multi-user production)
# EXPO_DATABASE_URL=sqlite:///data/expo.db
# EXPO_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/expo

# Data directory
EXPO_DATA_DIR=data

# Vision model (drawings / screenshots / scanned pages)
# EXPO_VISION_MODEL=qwen2.5vl:7b     # qwen2.5vl:32b = higher accuracy if hardware allows
# OLLAMA_HOST=http://127.0.0.1:11434
