# ==============================================================================
# ExpoDesignAI Production Environment Configuration (.env.production)
# ==============================================================================

# Server Environment & Network
EXPO_ENVIRONMENT=production
EXPO_HOST=0.0.0.0
EXPO_PORT=8090
EXPO_CORS_ORIGINS=https://expodesign.internal.corp,https://expodesign.company.com

# PostgreSQL Production Database (Connection Pooling Profile)
# Format: postgresql+psycopg2://<user>:<password>@<db-host>:5432/<dbname>
EXPO_DATABASE_URL=postgresql+psycopg2://expo_admin:SecureProductionPasswordHere@127.0.0.1:5432/expo_db
EXPO_DB_POOL_SIZE=20
EXPO_DB_MAX_OVERFLOW=10
EXPO_DB_POOL_TIMEOUT=30
EXPO_DB_POOL_RECYCLE=1800

# Authentication & Security
EXPO_SECRET=generate_with_openssl_rand_hex_32_change_me_in_production
EXPO_ADMIN_PASSWORD=SuperSecureAdminSecret2026!
EXPO_TOKEN_HOURS=12
EXPO_MAX_UPLOAD_SIZE_MB=2000

# Local AI Models (Ollama Service Architecture)
# Split Vision vs Reasoning if multi-GPU / separate instances are provisioned
EXPO_OLLAMA_HOST=http://127.0.0.1:11434
EXPO_CHAT_OLLAMA_HOST=http://127.0.0.1:11434
EXPO_VISION_OLLAMA_HOST=http://127.0.0.1:11434

EXPO_CHAT_MODEL=qwen3.5:9b
EXPO_VISION_MODEL=qwen2.5vl:7b
EXPO_EMBED_MODEL=bge-m3
EXPO_RERANKER_MODEL=bge-reranker-v2-m3
EXPO_RERANKER_ENABLED=true

# ComfyUI / Image Engine (RTX 5080 16GB Dedicated Pipeline)
EXPO_COMFYUI_BASE_URL=http://127.0.0.1:8188
EXPO_RENDER_MODEL=FLUX.2-klein-4B
EXPO_IMAGE_ENGINE_CONCURRENCY=1

# Feature Toggles
EXPO_ENABLE_STRUCTURED_TABLES=true
EXPO_ENABLE_QUANTITIES_STORE=true
EXPO_ENABLE_DOCUMENT_MEMORY=true
EXPO_ENABLE_HYBRID_BM25=true
EXPO_LOG_LEVEL=INFO
