# Expo Design AI - Container Sandbox Image (Option B)
# Pre-warmed with Python 3.12 and core engineering data analysis packages
FROM python:3.12-slim

# Set working directory and unbuffered output
WORKDIR /workspace
ENV PYTHONUNBUFFERED=1
ENV PYTHONIOENCODING=utf-8
ENV MPLBACKEND=Agg

# Install common system utilities for document and graphic processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install core data science, geometry, charting, and Excel/Word/report packages
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    scipy \
    matplotlib \
    openpyxl \
    shapely \
    reportlab \
    python-docx \
    xlsxwriter

# Create non-root user for isolated execution
RUN useradd -m -u 1000 sandboxuser && chown -R sandboxuser:sandboxuser /workspace
USER sandboxuser

CMD ["python"]
