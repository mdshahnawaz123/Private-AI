<#
.SYNOPSIS
    Expo Design AI — One-Click Production Installer & Launcher
.DESCRIPTION
    Downloads and configures everything a brand-new Windows user needs:
      1. Python 3.12 (if missing)
      2. Ollama (if missing)
      3. AI Models (qwen3.8:27b + bge-m3)
      4. All Python packages
      5. Starts the backend server
      6. Opens the UI in the default browser
    
    Run as:  Right-click → "Run with PowerShell"  (or:  powershell -ExecutionPolicy Bypass -File install.ps1)
#>

$ErrorActionPreference = "Continue"
$Host.UI.RawUI.WindowTitle = "Expo Design AI — Installer"

# ── Paths ──────────────────────────────────────────────────────
$ROOT       = Split-Path -Parent $MyInvocation.MyCommand.Definition
$VENV       = Join-Path $ROOT "venv"
$DATA       = Join-Path $ROOT "data"
$TEMP_DL    = Join-Path $ROOT "_downloads"
$PORT       = 8080

# ── Helpers ────────────────────────────────────────────────────
function Write-Step  { param($msg) Write-Host "`n  [>>] $msg" -ForegroundColor Cyan }
function Write-OK    { param($msg) Write-Host "  [OK] $msg" -ForegroundColor Green }
function Write-Warn  { param($msg) Write-Host "  [!!] $msg" -ForegroundColor Yellow }
function Write-Fail  { param($msg) Write-Host "  [XX] $msg" -ForegroundColor Red }

function Test-Command { param($cmd) return [bool](Get-Command $cmd -ErrorAction SilentlyContinue) }

Write-Host ""
Write-Host "  ╔═══════════════════════════════════════════════════════════╗" -ForegroundColor Magenta
Write-Host "  ║           EXPO DESIGN AI  —  Production Setup            ║" -ForegroundColor Magenta
Write-Host "  ║        Offline RAG · Dubai Engineering · Typesafe AI     ║" -ForegroundColor Magenta
Write-Host "  ╚═══════════════════════════════════════════════════════════╝" -ForegroundColor Magenta
Write-Host ""

# ═══════════════════════════════════════════════════════════════
# 1. PYTHON
# ═══════════════════════════════════════════════════════════════
Write-Step "Checking Python..."

$pythonCmd = $null
if (Test-Command "python") {
    $ver = & python --version 2>&1
    if ($ver -match "3\.(1[0-9]|[2-9][0-9])") {
        $pythonCmd = "python"
        Write-OK "Python found: $ver"
    }
}
if (-not $pythonCmd -and (Test-Command "python3")) {
    $ver = & python3 --version 2>&1
    if ($ver -match "3\.(1[0-9]|[2-9][0-9])") {
        $pythonCmd = "python3"
        Write-OK "Python3 found: $ver"
    }
}

if (-not $pythonCmd) {
    Write-Warn "Python 3.10+ not found. Downloading Python 3.12..."
    New-Item -ItemType Directory -Path $TEMP_DL -Force | Out-Null
    $pyUrl = "https://www.python.org/ftp/python/3.12.7/python-3.12.7-amd64.exe"
    $pyInstaller = Join-Path $TEMP_DL "python-installer.exe"
    
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri $pyUrl -OutFile $pyInstaller -UseBasicParsing
        Write-OK "Downloaded Python installer."
        
        Write-Step "Installing Python 3.12 (this may take a minute)..."
        Start-Process -FilePath $pyInstaller -ArgumentList "/quiet", "InstallAllUsers=0", "PrependPath=1", "Include_pip=1" -Wait
        
        # Refresh PATH
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path","Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path","User")
        
        if (Test-Command "python") {
            $pythonCmd = "python"
            Write-OK "Python 3.12 installed successfully."
        } else {
            Write-Fail "Python installed but not in PATH. Please restart this script."
            Write-Host "  Press any key to exit..." -ForegroundColor Yellow
            $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
            exit 1
        }
    } catch {
        Write-Fail "Failed to download Python: $_"
        Write-Host ""
        Write-Host "  Please install Python 3.12 manually from: https://python.org/downloads" -ForegroundColor Yellow
        Write-Host "  Make sure to check 'Add Python to PATH' during install." -ForegroundColor Yellow
        Write-Host "  Then re-run this script."
        Write-Host ""
        Write-Host "  Press any key to exit..." -ForegroundColor Yellow
        $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        exit 1
    }
}

# ═══════════════════════════════════════════════════════════════
# 2. OLLAMA
# ═══════════════════════════════════════════════════════════════
Write-Step "Checking Ollama..."

if (Test-Command "ollama") {
    Write-OK "Ollama found."
} else {
    Write-Warn "Ollama not found. Downloading..."
    New-Item -ItemType Directory -Path $TEMP_DL -Force | Out-Null
    $ollamaUrl = "https://ollama.com/download/OllamaSetup.exe"
    $ollamaInstaller = Join-Path $TEMP_DL "OllamaSetup.exe"
    
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri $ollamaUrl -OutFile $ollamaInstaller -UseBasicParsing
        Write-OK "Downloaded Ollama installer."
        
        Write-Step "Installing Ollama..."
        Start-Process -FilePath $ollamaInstaller -ArgumentList "/SILENT" -Wait
        
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path","Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path","User")
        
        if (Test-Command "ollama") {
            Write-OK "Ollama installed successfully."
        } else {
            # Try common install paths
            $ollamaPaths = @(
                "$env:LOCALAPPDATA\Programs\Ollama",
                "$env:ProgramFiles\Ollama",
                "$env:USERPROFILE\AppData\Local\Programs\Ollama"
            )
            foreach ($p in $ollamaPaths) {
                if (Test-Path (Join-Path $p "ollama.exe")) {
                    $env:Path += ";$p"
                    Write-OK "Ollama found at $p"
                    break
                }
            }
            if (-not (Test-Command "ollama")) {
                Write-Fail "Ollama installed but not in PATH. Please restart your computer and re-run."
                Write-Host "  Press any key to exit..."
                $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
                exit 1
            }
        }
    } catch {
        Write-Fail "Failed to download Ollama: $_"
        Write-Host "  Please install manually from: https://ollama.com/download" -ForegroundColor Yellow
        Write-Host "  Press any key to exit..."
        $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        exit 1
    }
}

# ═══════════════════════════════════════════════════════════════
# 3. START OLLAMA SERVER
# ═══════════════════════════════════════════════════════════════
Write-Step "Starting Ollama server..."

$ollamaRunning = Get-Process -Name "ollama" -ErrorAction SilentlyContinue
if ($ollamaRunning) {
    Write-OK "Ollama server already running."
} else {
    $env:OLLAMA_ORIGINS = "*"
    Start-Process -FilePath "ollama" -ArgumentList "serve" -WindowStyle Hidden
    Start-Sleep -Seconds 4
    Write-OK "Ollama server started."
}

# ═══════════════════════════════════════════════════════════════
# 4. PULL AI MODELS
# ═══════════════════════════════════════════════════════════════
Write-Step "Checking AI models (this can take a while on first run)..."

$modelList = & ollama list 2>&1 | Out-String

if ($modelList -match "qwen3.8") {
    Write-OK "Model qwen3.8:27b already available."
} else {
    Write-Warn "Downloading qwen3.8:27b (~16 GB) — grab a coffee..."
    & ollama pull qwen3.8:27b
    if ($LASTEXITCODE -eq 0) { Write-OK "qwen3.8:27b downloaded." }
    else { Write-Fail "Failed to pull qwen3.8:27b. Check your internet and disk space." }
}

if ($modelList -match "deepseek-r1:32b") {
    Write-OK "Model deepseek-r1:32b already available."
} else {
    Write-Warn "Downloading deepseek-r1:32b (~20 GB) — grab a coffee..."
    & ollama pull deepseek-r1:32b
    if ($LASTEXITCODE -eq 0) { Write-OK "deepseek-r1:32b downloaded." }
    else { Write-Fail "Failed to pull deepseek-r1:32b. Check your internet and disk space." }
}

if ($modelList -match "bge-m3") {
    Write-OK "Model bge-m3 already available."
} else {
    Write-Warn "Downloading bge-m3 embedding model..."
    & ollama pull bge-m3
    if ($LASTEXITCODE -eq 0) { Write-OK "bge-m3 downloaded." }
    else { Write-Fail "Failed to pull bge-m3." }
}

# ═══════════════════════════════════════════════════════════════
# 5. PYTHON VIRTUAL ENVIRONMENT + PACKAGES
# ═══════════════════════════════════════════════════════════════
Write-Step "Setting up Python environment..."

if (-not (Test-Path (Join-Path $VENV "Scripts\python.exe"))) {
    Write-Warn "Creating virtual environment..."
    & $pythonCmd -m venv $VENV
    Write-OK "Virtual environment created."
} else {
    Write-OK "Virtual environment exists."
}

$venvPython = Join-Path $VENV "Scripts\python.exe"
$venvPip    = Join-Path $VENV "Scripts\pip.exe"

Write-Step "Installing Python packages (first run may take 2-3 min)..."
& $venvPip install --upgrade pip --quiet 2>&1 | Out-Null
& $venvPip install -r (Join-Path $ROOT "requirements.txt") --quiet 2>&1 | Out-Null

if ($LASTEXITCODE -eq 0) {
    Write-OK "All Python packages installed."
} else {
    Write-Warn "Some packages may have had issues. Trying with --user fallback..."
    & $venvPip install -r (Join-Path $ROOT "requirements.txt") 2>&1 | Out-Null
}

# ═══════════════════════════════════════════════════════════════
# 6. CREATE DATA DIRECTORIES
# ═══════════════════════════════════════════════════════════════
Write-Step "Preparing data directories..."
@("$DATA", "$DATA\docs", "$DATA\projects", "$DATA\faiss_index") | ForEach-Object {
    New-Item -ItemType Directory -Path $_ -Force -ErrorAction SilentlyContinue | Out-Null
}
Write-OK "Data directories ready."

# ═══════════════════════════════════════════════════════════════
# 7. KILL OLD SERVER IF RUNNING ON SAME PORT
# ═══════════════════════════════════════════════════════════════
Write-Step "Checking for existing server on port $PORT..."

$existing = netstat -ano 2>$null | Select-String ":$PORT\s.*LISTENING"
if ($existing) {
    $pid = ($existing -split '\s+')[-1]
    $proc = Get-Process -Id $pid -ErrorAction SilentlyContinue
    if ($proc -and $proc.ProcessName -eq "python") {
        Write-Warn "Killing old Python server (PID $pid)..."
        Stop-Process -Id $pid -Force -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 2
    }
}

# ═══════════════════════════════════════════════════════════════
# 8. START BACKEND SERVER
# ═══════════════════════════════════════════════════════════════
Write-Step "Starting Expo Design AI backend on port $PORT..."

$serverArgs = "-c", "import uvicorn; import sys; sys.path.insert(0,'.'); uvicorn.run('main:app', host='127.0.0.1', port=$PORT)"
Start-Process -FilePath $venvPython -ArgumentList $serverArgs -WorkingDirectory $ROOT -WindowStyle Hidden

# Wait for server to become ready
$ready = $false
for ($i = 0; $i -lt 15; $i++) {
    Start-Sleep -Seconds 1
    try {
        $response = Invoke-RestMethod -Uri "http://127.0.0.1:$PORT/health" -TimeoutSec 2 -ErrorAction Stop
        if ($response.status -eq "ok") {
            $ready = $true
            break
        }
    } catch { }
    Write-Host "." -NoNewline -ForegroundColor DarkGray
}
Write-Host ""

if ($ready) {
    Write-OK "Backend server is LIVE on http://127.0.0.1:$PORT"
} else {
    Write-Warn "Server may still be starting. Give it a few more seconds..."
}

# ═══════════════════════════════════════════════════════════════
# 9. OPEN UI IN BROWSER
# ═══════════════════════════════════════════════════════════════
Write-Step "Opening UI in browser..."

$uiUrl = "http://127.0.0.1:$PORT/ui/"
Start-Process $uiUrl
Write-OK "UI opened in browser: $uiUrl"

# ═══════════════════════════════════════════════════════════════
# 10. CLEANUP
# ═══════════════════════════════════════════════════════════════
if (Test-Path $TEMP_DL) {
    Remove-Item -Path $TEMP_DL -Recurse -Force -ErrorAction SilentlyContinue
}

# ═══════════════════════════════════════════════════════════════
# DONE
# ═══════════════════════════════════════════════════════════════
Write-Host ""
Write-Host "  ╔═══════════════════════════════════════════════════════════╗" -ForegroundColor Green
Write-Host "  ║         Expo Design AI is RUNNING!                       ║" -ForegroundColor Green
Write-Host "  ║                                                          ║" -ForegroundColor Green
Write-Host "  ║   UI:   ui\index.html  (opened in browser)              ║" -ForegroundColor Green
Write-Host "  ║   API:  http://127.0.0.1:$PORT/docs                     ║" -ForegroundColor Green
Write-Host "  ║   Model: qwen3.8:27b (27B params, high reasoning)       ║" -ForegroundColor Green
Write-Host "  ║                                                          ║" -ForegroundColor Green
Write-Host "  ║   Features:                                              ║" -ForegroundColor Green
Write-Host "  ║     - Upload PDF / DOCX / XLSX for RAG analysis          ║" -ForegroundColor Green
Write-Host "  ║     - Typesafe AI Mode for structured JSON output        ║" -ForegroundColor Green
Write-Host "  ║     - Conversational memory (follow-up questions)        ║" -ForegroundColor Green
Write-Host "  ║     - Project-isolated knowledge bases                   ║" -ForegroundColor Green
Write-Host "  ║     - Live HTML/SVG/Code preview                         ║" -ForegroundColor Green
Write-Host "  ║     - Stop generation anytime                            ║" -ForegroundColor Green
Write-Host "  ║                                                          ║" -ForegroundColor Green
Write-Host "  ║   To stop: Close this window or Ctrl+C                   ║" -ForegroundColor Green
Write-Host "  ╚═══════════════════════════════════════════════════════════╝" -ForegroundColor Green
Write-Host ""
Write-Host "  Press any key to exit the launcher (server keeps running)..." -ForegroundColor DarkGray
$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
