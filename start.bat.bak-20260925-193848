@echo off
setlocal EnableDelayedExpansion
title Expo Design AI - Launcher
color 0B
cd /d "%~dp0"

echo.
echo  ============================================================
echo    EXPO DESIGN AI  -  Local RAG Launcher
echo  ============================================================
echo.

REM ---------- 1. Ollama check ----------
where ollama >nul 2>&1
if errorlevel 1 (
    echo  [ERROR] Ollama not found in PATH.
    pause & exit /b 1
)
echo  [OK] Ollama detected.

REM ---------- 2. Ollama server ----------
tasklist /FI "IMAGENAME eq ollama.exe" 2>NUL | find /I "ollama.exe" >NUL
if errorlevel 1 (
    echo  [..] Starting Ollama server...
    set OLLAMA_ORIGINS=*
    start "Ollama Server" /min cmd /c "set OLLAMA_ORIGINS=* && ollama serve"
    timeout /t 5 /nobreak >nul
) else (
    echo  [OK] Ollama server already running.
)

REM ---------- 3. Python check ----------
where python >nul 2>&1
if errorlevel 1 (
    echo  [ERROR] Python not found in PATH.
    pause & exit /b 1
)
echo  [OK] Python detected.

REM ---------- 4. Install packages (uses --user to avoid admin) ----------
echo  [..] Installing required packages...
python -m pip install --upgrade pip --quiet
python -m pip install --user --quiet -r requirements.txt
if errorlevel 1 (
    echo  [ERROR] Package installation failed.
    pause & exit /b 1
)
echo  [OK] Packages installed.

REM ---------- 5. Check models ----------
echo  [..] Checking models...
ollama list | findstr /C:"qwen3.8" >nul
if errorlevel 1 (
    echo  [..] Pulling qwen3.8:27b ^(~16 GB, this takes a while^)...
    ollama pull qwen3.8:27b
)
ollama list | findstr /C:"bge-m3" >nul
if errorlevel 1 (
    echo  [..] Pulling bge-m3 embedding model...
    ollama pull bge-m3
)
ollama list | findstr /C:"qwen2.5vl" >nul
if errorlevel 1 (
    echo  [..] Pulling qwen2.5vl:7b vision model...
    ollama pull qwen2.5vl:7b
)
echo  [OK] Models ready.

REM ---------- 6. Start FastAPI ----------
echo  [..] Starting backend on http://127.0.0.1:8090
start "Expo RAG Backend" /min cmd /c "cd /d %~dp0 && python main.py"

REM ---------- 7. Wait, open UI ----------
timeout /t 6 /nobreak >nul
start "" "http://127.0.0.1:8090/ui/"

echo.
echo  ============================================================
echo    Expo Design AI is RUNNING
echo    UI:  http://127.0.0.1:8090/ui/
echo    API: http://127.0.0.1:8090/docs
echo  ============================================================
echo.
echo  Press any key to close this launcher...
pause >nul