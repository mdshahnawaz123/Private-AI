{
  "name": "expo-fragments-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server-side IFC -> Fragments (.frag) converter for Expo Design AI (runs at upload time).",
  "bin": {
    "ifc2frag": "./convert_ifc_to_frag.mjs"
  },
  "scripts": {
    "build:browser": "node build_browser.mjs",
    "convert": "node convert_ifc_to_frag.mjs",
    "backfill": "node backfill.mjs"
  },
  "engines": { "node": ">=20.11.0" },
  "dependencies": {
    "@thatopen/fragments": "3.4.8",
    "three": "0.186.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
