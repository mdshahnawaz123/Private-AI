      </div>
      <div>Ask the AI to build HTML, CSS, JS, or SVG,<br>and it will render here live.</div>
    </div>
    <iframe id="previewFrame" class="preview-frame" sandbox="allow-scripts allow-same-origin" style="display:none"></iframe>
  </aside>
</div>

<script>
/* ============================================================
   CONFIG
   ============================================================ */
const API = window.location.origin;   // always talk to the port the page is served from

/* ============================================================
   DOM REFERENCES
   ============================================================ */
const chatEl       = document.getElementById('chat');
const welcomeEl    = document.getElementById('welcome');
const inputEl      = document.getElementById('input');
const sendBtn      = document.getElementById('sendBtn');
const fileInput    = document.getElementById('fileInput');
const app          = document.getElementById('app');
const frame        = document.getElementById('previewFrame');
const emptyPrev    = document.getElementById('previewEmpty');
const previewTitle = document.getElementById('previewTitle');
const modePill     = document.getElementById('modePill');
const footerHint   = document.getElementById('footerHint');
const welcomeText  = document.getElementById('welcomeText');
const historyList  = document.getElementById('historyList');
const projList     = document.getElementById('projList');

/* ============================================================
   STATE
   ============================================================ */
let attachedFiles    = [];
let currentArtifact  = null;
let previewOpen      = false;
let coworkMode       = false;
let currentChatId    = null;
let currentProject   = 'default';
let currentMessages  = [];
let projectsData     = {};
let isStreaming      = false;

/* ============================================================
   SVG ICON HELPERS
   ============================================================ */
const ICONS = {
  folder: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
  chat:   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  copy:   '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>',
  check:  '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  play:   '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>',
  zap:    '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  alert:  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
  user:   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  people: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
};

/* ============================================================
   INIT
   ============================================================ */
window.addEventListener('DOMContentLoaded', () => {
  loadProjects();
  inputEl.focus();
});

/* ============================================================
   PROJECTS & HISTORY
   ============================================================ */
async function loadProjects() {
  try {
    const r = await fetch(`${API}/projects`);
    projectsData = await r.json();
    if (!projectsData['default']) projectsData['default'] = [];
    renderProjects();
    renderHistory();
  } catch (e) {
    console.warn('Projects load failed:', e);
    projectsData = { 'default': [] };
    renderProjects();
    renderHistory();
  }
}

function renderProjects() {
  projList.innerHTML = '';
  Object.keys(projectsData).forEach(name => {
    const el = document.createElement('div');
    el.className = 'proj-item' + (name === currentProject ? ' active' : '');
    el.innerHTML = `${ICONS.folder} <span>${escapeHtml(name)}</span>`;
    el.onclick = () => {
      currentProject = name;
      currentChatId = null;
      renderProjects();
      renderHistory();
    };
    projList.appendChild(el);
  });
}

function renderHistory() {
  historyList.innerHTML = '';
  const chats = projectsData[currentProject] || [];
  if (chats.length === 0) {
    historyList.innerHTML = `<div style="padding:10px 12px;font-size:12px;color:var(--muted)">No chats yet</div>`;
    return;
  }
  chats.slice().reverse().forEach(cid => {
    const el = document.createElement('div');
    el.className = 'history-item' + (cid === currentChatId ? ' active' : '');
    const displayTitle = cid.replace(/^chat-/, '').replace(/-/g, ' ');
    el.innerHTML = `${ICONS.chat} <span class="ti">${escapeHtml(displayTitle)}</span><span class="del" title="Delete">&times;</span>`;
    el.onclick = async (e) => {
      if (e.target.classList.contains('del')) {
        e.stopPropagation();
        await deleteChat(cid);
        return;
      }
      await openChat(cid);
    };
    historyList.appendChild(el);
  });
}

function createProject() {
  const name = prompt('Project name:');
  if (!name) return;
  const clean = name.trim().replace(/[^a-zA-Z0-9_\- ]/g, '').replace(/\s+/g, '-');
  if (!clean) return;
  currentProject = clean;
  if (!projectsData[clean]) projectsData[clean] = [];
  renderProjects();
  renderHistory();
}

async function openChat(chatId) {
  try {
    const r = await fetch(`${API}/projects/${currentProject}/${chatId}`);
    if (!r.ok) throw new Error('Not found');
    const data = await r.json();
    currentChatId = chatId;
    currentMessages = data.messages || [];
    chatEl.innerHTML = '';
    welcomeEl.style.display = 'none';
    for (const m of currentMessages) {
      appendMessage(m.role, m.content, false);
    }
    renderHistory();
    chatEl.scrollTop = chatEl.scrollHeight;
  } catch (e) {
    alert('Could not load chat: ' + e.message);
  }
}

async function deleteChat(chatId) {
  if (!confirm('Delete this chat?')) return;
  try {
    await fetch(`${API}/projects/${currentProject}/${chatId}`, { method: 'DELETE' });
    projectsData[currentProject] = projectsData[currentProject].filter(c => c !== chatId);
    if (currentChatId === chatId) newChat();
    renderHistory();
  } catch (e) {
    alert('Delete failed: ' + e.message);
  }
}

async function clearDocs() {
  if (!confirm(`Clear all indexed documents for project "${currentProject}"?`)) return;
  try {
    const res = await fetch(`${API}/projects/${currentProject}/docs`, { method: 'DELETE' });
    if (!res.ok) throw new Error(await res.text());
    alert('Knowledge Base cleared successfully!');
  } catch (e) {
    alert('Failed to clear docs: ' + e.message);
  }
}

async function saveChat() {
  if (!currentChatId) {
    currentChatId = `chat-${Date.now()}`;
  }
  try {
    await fetch(`${API}/projects/save`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        project: currentProject,
        chat_id: currentChatId,
        title: currentMessages[0]?.content?.slice(0, 40) || 'Untitled',
        messages: currentMessages
      })
    });
    if (!projectsData[currentProject].includes(currentChatId)) {
      projectsData[currentProject].push(currentChatId);
    }
    renderHistory();
  } catch (e) {
    console.warn('Save failed:', e);
  }
}

/* ============================================================
   CHAT
   ============================================================ */
function newChat() {
  attachedFiles = [];
  renderChips();
  currentChatId = null;
  currentMessages = [];
  chatEl.innerHTML = '';
  chatEl.appendChild(welcomeEl);
  welcomeEl.style.display = 'flex';
  inputEl.value = '';
  inputEl.placeholder = 'Message Expo Design AI...';
  closePreview();
  renderHistory();
}

function useSuggestion(t) {
  inputEl.value = t;
  sendMessage();
}

/* ============================================================
   COWORK MODE
   ============================================================ */
function toggleCowork() {
  coworkMode = !coworkMode;
  modePill.innerHTML = coworkMode
    ? `${ICONS.people} Cowork`
    : `${ICONS.chat} Chat`;
  modePill.classList.toggle('cowork', coworkMode);
  footerHint.textContent = coworkMode
    ? 'Cowork: The AI sees the current artifact and iterates on it.'
    : 'Expo Design AI runs 100% offline. Responses are streamed live.';
}

let typesafeMode = false;
function toggleTypesafe() {
  typesafeMode = !typesafeMode;
  const pill = document.getElementById('typesafePill');
  pill.classList.toggle('cowork', typesafeMode);
  if (typesafeMode) {
    pill.style.background = '#10b981';
    pill.style.color = '#fff';
    pill.style.borderColor = '#10b981';
    footerHint.textContent = 'Typesafe AI Mode ON: Outputs strictly typed JSON schemas for engineering checks.';
  } else {
    pill.style.background = '';
    pill.style.color = '';
    pill.style.borderColor = '';
    footerHint.textContent = 'Expo Design AI runs 100% offline. Responses are streamed live.';
  }
}

/* ============================================================
   PREVIEW
   ============================================================ */
function togglePreview() {
  previewOpen = !previewOpen;
  app.classList.toggle('preview-open', previewOpen);
  document.getElementById('previewToggle').classList.toggle('active', previewOpen);
}

function showPreview(code, lang) {
  currentArtifact = { code, lang };
  let html = code;
  if (lang === 'svg') {
    html = `<!DOCTYPE html><html><body style="margin:0;display:grid;place-items:center;height:100vh;background:#f5f5f7">${code}</body></html>`;
  } else if (lang === 'javascript' || lang === 'js') {
    html = `<!DOCTYPE html><html><body style="font-family:monospace;padding:20px;background:#09090b;color:#f4f4f5"><div id="out"></div><script>
      console.log=(...a)=>{document.getElementById('out').innerHTML+=a.map(x=>typeof x==='object'?JSON.stringify(x,null,2):String(x)).join(' ')+'<br>'};
      try{${code}}catch(e){document.getElementById('out').innerHTML+='<span style="color:#ef4444">Error: '+e.message+'</span>'}
    <\/script></body></html>`;
  } else if (['css', 'json', 'text', 'python', 'py'].includes(lang)) {
    html = `<!DOCTYPE html><html><body style="margin:0;padding:20px;background:#09090b;color:#f4f4f5;font-family:monospace;font-size:13px;white-space:pre-wrap">${escapeHtml(code)}</body></html>`;
  }
  frame.srcdoc = html;
  frame.style.display = 'block';
  emptyPrev.style.display = 'none';
  previewTitle.textContent = `Artifact (${lang || 'html'})`;
  if (!previewOpen) togglePreview();
}

function closePreview() {
  currentArtifact = null;
  frame.style.display = 'none';
  emptyPrev.style.display = 'flex';
  previewTitle.textContent = 'Live Preview';
}

function openPreviewTab() {
  if (!currentArtifact) return;
  const w = window.open('', '_blank');
  w.document.write(frame.srcdoc);
  w.document.close();
}

function downloadPreview() {
  if (!currentArtifact) return;
  const ext = currentArtifact.lang === 'svg' ? 'svg'
            : currentArtifact.lang === 'css' ? 'css'
            : currentArtifact.lang === 'json' ? 'json'
            : (currentArtifact.lang === 'python' || currentArtifact.lang === 'py') ? 'py'
            : 'html';
  const blob = new Blob([currentArtifact.code], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `expo-artifact.${ext}`;
  a.click();
}

/* ============================================================
   RESIZE
   ============================================================ */
const resizer = document.getElementById('resizer');
let isResizing = false;
resizer.addEventListener('mousedown', e => {
  isResizing = true;
  document.body.style.cursor = 'col-resize';
  document.body.style.userSelect = 'none';
  e.preventDefault();
});
document.addEventListener('mousemove', e => {
  if (!isResizing) return;
  const minW = 320, maxW = window.innerWidth - 300;
  const w = Math.max(minW, Math.min(maxW, window.innerWidth - e.clientX));
  document.documentElement.style.setProperty('--preview-w', w + 'px');
});
document.addEventListener('mouseup', () => {
  if (isResizing) {
    isResizing = false;
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
  }
});

/* ============================================================
   INPUT HANDLERS
   ============================================================ */
inputEl.addEventListener('input', () => {
  inputEl.style.height = 'auto';
  inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
});
inputEl.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});
// ---- Claude-style composer: multi-attach, drag & drop, paste ----
const kbInput    = document.getElementById('kbInput');
const plusMenu   = document.getElementById('plusMenu');
const composerEl = document.getElementById('composer');

function renderChips(){
  const wrap = document.getElementById('attachChips');
  if(!wrap) return;
  wrap.innerHTML = '';
  attachedFiles.forEach((f, i) => {
    const chip = document.createElement('div');
    chip.className = 'chip';
    let thumb;
    if (f.type && f.type.indexOf('image/') === 0){
      thumb = document.createElement('img');
      thumb.src = URL.createObjectURL(f);
    } else {
      thumb = document.createElement('div');
      thumb.className = 'chip-ic';
      thumb.textContent = (f.name.split('.').pop() || '').slice(0,4).toUpperCase();
    }
    const name = document.createElement('span');
    name.className = 'chip-name';
    name.textContent = f.name;
    const x = document.createElement('span');
    x.className = 'chip-x';
    x.textContent = '\u2715';
    x.title = 'Remove';
    x.onclick = () => { attachedFiles.splice(i,1); renderChips(); };
    chip.appendChild(thumb); chip.appendChild(name); chip.appendChild(x);
    wrap.appendChild(chip);
  });
}
function addFiles(list){
  if(!list) return;
  for (const f of list) attachedFiles.push(f);
  renderChips();
}
function pickFiles(kind){
  closePlusMenu();
  if (kind === 'kb') kbInput.click(); else fileInput.click();
}
function togglePlusMenu(e){ if(e) e.stopPropagation(); plusMenu.hidden = !plusMenu.hidden; }
function closePlusMenu(){ if(plusMenu) plusMenu.hidden = true; }
document.addEventListener('click', closePlusMenu);

fileInput.addEventListener('change', e => { addFiles(e.target.files); fileInput.value = ''; });

kbInput.addEventListener('change', async e => {
  const files = [...e.target.files]; kbInput.value = '';
  for (const f of files){
    appendMessage('ai', 'Loading code reference into the knowledge base: ' + f.name + ' ...');
    try {
      const fd = new FormData(); fd.append('file', f);
      const r = await fetch(`${API}/kb/upload`, { method:'POST', body: fd });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.detail || ('HTTP ' + r.status));
      appendMessage('ai', 'Loaded **' + f.name + '** into the code knowledge base (' + j.chunks + ' chunks).');
    } catch(err){ appendMessage('ai', 'Failed to load ' + f.name + ': ' + err.message); }
  }
});

['dragenter','dragover'].forEach(ev => composerEl.addEventListener(ev, e => { e.preventDefault(); composerEl.classList.add('dragover'); }));
composerEl.addEventListener('dragleave', e => { if (e.target === composerEl) composerEl.classList.remove('dragover'); });
composerEl.addEventListener('drop', e => {
  e.preventDefault(); composerEl.classList.remove('dragover');
  if (e.dataTransfer && e.dataTransfer.files.length) addFiles(e.dataTransfer.files);
});

inputEl.addEventListener('paste', e => {
  const items = (e.clipboardData && e.clipboardData.items) ? e.clipboardData.items : [];
  const imgs = [];
  for (const it of items){
    if (it.kind === 'file'){
      const f = it.getAsFile();
      if (f){
        const ext = (f.type.split('/')[1] || 'png');
        const nm = (f.name && f.name !== 'image.png') ? f.name : ('pasted-' + Date.now() + '.' + ext);
        try { imgs.push(new File([f], nm, {type: f.type})); } catch(_) { imgs.push(f); }
      }
    }
  }
  if (imgs.length){ e.preventDefault(); addFiles(imgs); }
});

/* ============================================================
   SEND MESSAGE (with streaming)
   ============================================================ */
let abortController = null;

async function sendMessage() {
  const text = inputEl.value.trim();
  if ((!text && !attachedFiles.length) || isStreaming) return;

  welcomeEl.style.display = 'none';
  const names = attachedFiles.map(f => f.name);
  const userText = text + (names.length ? `\n\nAttached: ${names.join(', ')}` : '');
  appendMessage('user', userText);
  currentMessages.push({ role: 'user', content: userText });

  inputEl.value = '';
  inputEl.style.height = 'auto';
  
  isStreaming = true;
  sendBtn.innerHTML = '&#9209;'; // Stop icon
  sendBtn.title = 'Stop Generating';
  sendBtn.onclick = () => {
    if (abortController) abortController.abort();
  };

  try {
    if (attachedFiles.length) {
      const disc = (document.getElementById('disciplineSelect') || {}).value || '';
      for (const f of attachedFiles) {
        const fd = new FormData();
        fd.append('file', f);
        fd.append('project', currentProject);
        if (disc) fd.append('discipline', disc);
        const ur = await fetch(`${API}/upload`, { method: 'POST', body: fd });
        if (!ur.ok) throw new Error('Upload failed for ' + f.name + ': ' + (await ur.text()));
      }
      attachedFiles = [];
      renderChips();
    }

    let prompt = text;
    if (coworkMode && currentArtifact) {
      prompt = `You are in COWORK mode. The user is iterating on an artifact.

CURRENT ARTIFACT (${currentArtifact.lang}):
\`\`\`${currentArtifact.lang}
${currentArtifact.code}
\`\`\`

USER REQUEST: ${text}

Return the COMPLETE updated artifact in a single fenced \`\`\`${currentArtifact.lang} code block.`;
    } else {
      prompt = text + "\n\nIMPORTANT: If your answer includes complete HTML, CSS+HTML, SVG, or runnable code, wrap the ENTIRE code in a fenced block with the language identifier (e.g. \`\`\`html ... \`\`\`). Make it a single self-contained document so it can be rendered live.";
    }

    const docsReady = await hasDocs();
    const endpoint = docsReady ? `${API}/ask_stream` : `${API}/ask_chat`;
    await streamResponse(prompt, endpoint);

    await saveChat();
  } catch (e) {
    if (e.name === 'AbortError') {
      appendMessage('ai', 'Generation stopped.');
    } else {
      appendMessage('ai', `Error: ${e.message}`);
    }
  }

  isStreaming = false;
  sendBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>`;
  sendBtn.title = 'Send';
  sendBtn.onclick = sendMessage;
  inputEl.focus();
  inputEl.focus();
}

let hasDocsCache = false;
async function hasDocs() {
  try {
    const r = await fetch(`${API}/health?project=${currentProject}`);
    const d = await r.json();
    hasDocsCache = d.documents_indexed;
    return hasDocsCache;
  } catch {
    return hasDocsCache;
  }
}

/* ============================================================
   STREAMING READER
   ============================================================ */
async function streamResponse(prompt, endpoint) {
  const typingEl = appendTyping();
  const msgEl = document.createElement('div');
  msgEl.className = 'msg ai';
  msgEl.innerHTML = `<div class="avatar">E</div><div class="bubble" id="streamBubble"><span class="cursor-blink"></span></div>`;
  typingEl.replaceWith(msgEl);
  const bubble = msgEl.querySelector('#streamBubble');
  let fullText = '';

  abortController = new AbortController();

  const res = await fetch(endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ 
      query: prompt, 
      project: currentProject, 
      messages: currentMessages.slice(0, -1),
      k: 3,
      format: typesafeMode ? 'json' : 'text',
      model: document.getElementById('modelSelect').value,
      mode: coworkMode ? 'cowork' : 'chat',
      discipline: (document.getElementById('disciplineSelect') || {}).value || ''
    }),
    signal: abortController.signal
  });
  if (!res.ok) throw new Error('Stream failed: ' + res.status);

  const reader = res.body.getReader();
  const decoder = new TextDecoder();
  let buffer = '';

  try {
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n\n');
      buffer = lines.pop() || '';
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;
        try {
          const data = JSON.parse(line.slice(6));
          if (data.type === 'token') {
            fullText += data.text;
            bubble.innerHTML = formatText(fullText) + '<span class="cursor-blink"></span>';

          chatEl.scrollTop = chatEl.scrollHeight;
        } else if (data.type === 'done') {
          bubble.innerHTML = formatText(fullText);
        } else if (data.type === 'error') {
          bubble.innerHTML = `${ICONS.alert} <span style="color:#ef4444">${escapeHtml(data.message)}</span>`;
        }
      } catch (err) {
        console.warn('Parse error:', err, line);
      }
    }
  }
  } catch (e) {
    if (e.name === 'AbortError') {
      console.log('Stream aborted');
    } else {
      throw e;
    }
  }

  if (!fullText.trim()) fullText = '(no response)';
  currentMessages.push({ role: 'assistant', content: fullText });

  convertArtifacts(bubble, fullText);
  autoOpenArtifact(fullText);
  chatEl.scrollTop = chatEl.scrollHeight;
}

/* ============================================================
   MESSAGE RENDERING
   ============================================================ */
function appendMessage(role, text, animate = true) {
  const m = document.createElement('div');
  m.className = `msg ${role}`;
  if (!animate) m.style.animation = 'none';

  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  bubble.innerHTML = formatText(text);

  if (role === 'ai') convertArtifacts(bubble, text);

  const msgDl = document.createElement('button');
  msgDl.className = 'copy-msg-btn';
  msgDl.style.right = role === 'ai' ? '70px' : 'auto';
  msgDl.style.left  = role === 'user' ? '70px' : 'auto';
  msgDl.textContent = 'Download';
  msgDl.onclick = () => {
    const blob = new Blob([text], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'expo-response-' + Date.now() + '.txt';
    a.click();
  };
  m.innerHTML = `<div class="avatar">${role === 'user' ? 'You' : 'E'}</div>`;
  m.appendChild(bubble);
  if (role === 'ai') m.appendChild(msgDl);
  chatEl.appendChild(m);
  chatEl.scrollTop = chatEl.scrollHeight;
}

function convertArtifacts(bubble, fullText) {
  const arts = extractArtifacts(fullText);
  let idx = 0;
  bubble.querySelectorAll('pre').forEach(pre => {
    const code = pre.querySelector('code');
    const raw = code ? code.textContent : '';
    const cls = code ? code.className : '';
    const lang = (arts[idx]?.lang) || (cls.replace('language-', '') || '').toLowerCase();
    if (['html', 'svg', 'javascript', 'js', 'css', 'json', 'python', 'py'].includes(lang)) {
      const card = document.createElement('div');
      card.className = 'artifact-card';

      const header = document.createElement('div');
      header.className = 'artifact-header';
      header.innerHTML = `<div class="title">${ICONS.zap} ${lang.toUpperCase()} Artifact</div>`;

      const actions = document.createElement('div');
      actions.className = 'artifact-actions';

      const openBtn = document.createElement('button');
      openBtn.className = 'artifact-btn primary';
      openBtn.innerHTML = `${ICONS.play} Preview`;
      openBtn.onclick = () => showPreview(raw, lang);

      const copyBtn = document.createElement('button');
      copyBtn.className = 'artifact-btn';
      copyBtn.innerHTML = `${ICONS.copy} Copy`;
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(raw);
        copyBtn.innerHTML = `${ICONS.check} Copied`;
        setTimeout(() => copyBtn.innerHTML = `${ICONS.copy} Copy`, 1500);
      };

      const dlBtn = document.createElement('button');
      dlBtn.className = 'artifact-btn';
      dlBtn.textContent = 'Download';
      dlBtn.onclick = () => {
        const ext = lang === 'svg' ? 'svg'
                  : lang === 'css' ? 'css'
                  : lang === 'json' ? 'json'
                  : (lang === 'python' || lang === 'py') ? 'py'
                  : (lang === 'javascript' || lang === 'js') ? 'js'
                  : 'html';
        const blob = new Blob([raw], { type: 'text/plain' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'expo-artifact-' + Date.now() + '.' + ext;
        a.click();
      };
      actions.appendChild(openBtn);
      actions.appendChild(copyBtn);
      actions.appendChild(dlBtn);
      header.appendChild(actions);
      card.appendChild(header);
      pre.replaceWith(card);
      card.appendChild(pre);
      idx++;
    }
  });
}

function autoOpenArtifact(text) {
  const arts = extractArtifacts(text);
  if (arts.length > 0) {
    const a = arts[0];
    if (['html', 'svg', 'javascript', 'js'].includes(a.lang)) {
      showPreview(a.code, a.lang);
    }
  }
}

function appendTyping() {
  const m = document.createElement('div');
  m.className = 'msg ai';
  m.innerHTML = '<div class="avatar">E</div><div class="bubble"><div class="typing"><span></span><span></span><span></span></div></div>';
  chatEl.appendChild(m);
  chatEl.scrollTop = chatEl.scrollHeight;
  return m;
}

/* ============================================================
   HELPERS
   ============================================================ */
function extractArtifacts(text) {
  const out = [];
  // Strip <think> tags for artifact extraction
  const cleanText = text.replace(/<think>[\s\S]*?<\/think>/g, '');
  
  const re = /```\s*(\w+)?\s*\r?\n([\s\S]*?)```/g;
  let m;
  while ((m = re.exec(cleanText))) out.push({ lang: (m[1] || 'text').toLowerCase(), code: m[2].trim() });
  
  // Fallback: if AI forgot backticks but output raw HTML
  if (out.length === 0 && (cleanText.includes('</div>') || cleanText.includes('</style>') || cleanText.includes('</svg>') || cleanText.includes('</html>'))) {
     out.push({ lang: 'html', code: cleanText.trim() });
  }
  
  return out;
}

function escapeHtml(s) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function formatText(text) {
  // ── Full inline markdown renderer (works 100% offline) ──

  let s = text;
  
  // 0) Handle <think> blocks (DeepSeek)
  s = s.replace(/<think>([\s\S]*?)<\/think>/g, (match, thinkContent) => {
    return `<div style="margin: 12px 0; padding: 12px 16px; background: rgba(255,255,255,0.03); border-left: 3px solid #6b7280; color: #9ca3af; font-size: 13px; font-style: italic; border-radius: 0 8px 8px 0;"><strong>Thinking Process:</strong><br>${escapeHtml(thinkContent).replace(/\n/g, '<br>')}</div>`;
  });
  // Handle unclosed <think> block (while streaming)
  s = s.replace(/<think>([\s\S]*)$/g, (match, thinkContent) => {
    return `<div style="margin: 12px 0; padding: 12px 16px; background: rgba(255,255,255,0.03); border-left: 3px solid #6b7280; color: #9ca3af; font-size: 13px; font-style: italic; border-radius: 0 8px 8px 0;"><strong>Thinking Process:</strong><br>${escapeHtml(thinkContent).replace(/\n/g, '<br>')}</div>`;
  });

  // Fallback: If AI output raw HTML without backticks, wrap it in backticks so it gets highlighted
  if (!s.includes('```') && (s.includes('</div>') || s.includes('</style>') || s.includes('</svg>') || s.includes('</html>'))) {
    s = '```html\n' + s.trim() + '\n```';
  }

  // 1) Extract code blocks first, replace with placeholders
  const codeBlocks = [];
  s = s.replace(/```\s*(\w+)?\s*\r?\n([\s\S]*?)```/g, (_, lang, code) => {
    const idx = codeBlocks.length;
    const highlighted = highlightCode(code.trim(), lang || 'text');
    codeBlocks.push(`<pre class="code-block"><div class="code-header"><span class="code-lang">${(lang || 'text').toUpperCase()}</span></div><code class="language-${lang || 'text'}">${highlighted}</code></pre>`);
    return `%%CODEBLOCK_${idx}%%`;
  });
  
  // Handle unclosed code block (while streaming)
  s = s.replace(/```\s*(\w+)?\s*\r?\n([\s\S]*)$/g, (_, lang, code) => {
    const idx = codeBlocks.length;
    const highlighted = highlightCode(code.trim(), lang || 'text');
    codeBlocks.push(`<pre class="code-block"><div class="code-header"><span class="code-lang">${(lang || 'text').toUpperCase()} (typing...)</span></div><code class="language-${lang || 'text'}">${highlighted}</code></pre>`);
    return `%%CODEBLOCK_${idx}%%`;
  });

  // 2) Escape HTML in remaining text
  s = s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // 3) Tables (must come before line-based processing)
  s = s.replace(/^(\|.+\|)\r?\n(\|[\s\-:|]+\|)\r?\n((?:\|.+\|\r?\n?)+)/gm, (match, header, sep, bodyBlock) => {
    const hCells = header.split('|').filter(c => c.trim());
    const rows = bodyBlock.trim().split('\n');
    let html = '<table><thead><tr>';
    hCells.forEach(c => html += `<th>${c.trim()}</th>`);
    html += '</tr></thead><tbody>';
    rows.forEach(row => {
      const cells = row.split('|').filter(c => c.trim());
      html += '<tr>';
      cells.forEach(c => html += `<td>${c.trim()}</td>`);
      html += '</tr>';
    });
    html += '</tbody></table>';
    return html;
  });

  // 4) Headers
  s = s.replace(/^#### (.+)$/gm, '<h4>$1</h4>');
  s = s.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  s = s.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  s = s.replace(/^# (.+)$/gm, '<h1>$1</h1>');

  // 5) Blockquotes
  s = s.replace(/^&gt; (.+)$/gm, '<blockquote>$1</blockquote>');

  // 6) Unordered lists
  s = s.replace(/(?:^|\n)((?:[\t ]*[-*] .+\n?)+)/g, (match, block) => {
    const items = block.trim().split('\n').map(line => {
      return '<li>' + line.replace(/^[\t ]*[-*] /, '') + '</li>';
    }).join('');
    return `<ul>${items}</ul>`;
  });

  // 7) Ordered lists
  s = s.replace(/(?:^|\n)((?:[\t ]*\d+\. .+\n?)+)/g, (match, block) => {
    const items = block.trim().split('\n').map(line => {
      return '<li>' + line.replace(/^[\t ]*\d+\. /, '') + '</li>';
    }).join('');
    return `<ol>${items}</ol>`;
  });

  // 8) Horizontal rules
  s = s.replace(/^---$/gm, '<hr>');

  // 9) Inline formatting
  s = s.replace(/\*\*\*([^*]+)\*\*\*/g, '<strong><em>$1</em></strong>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  s = s.replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>');

  // 10) Links
  s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" style="color:var(--accent)">$1</a>');

  // 11) Line breaks (convert remaining newlines, but not inside block elements)
  s = s.replace(/\n/g, '<br>');

  // 12) Clean up excessive <br> after block elements
  s = s.replace(/(<\/h[1-4]>)<br>/g, '$1');
  s = s.replace(/(<\/ul>)<br>/g, '$1');
  s = s.replace(/(<\/ol>)<br>/g, '$1');
  s = s.replace(/(<\/table>)<br>/g, '$1');
  s = s.replace(/(<\/blockquote>)<br>/g, '$1');
  s = s.replace(/(<\/pre>)<br>/g, '$1');
  s = s.replace(/(<hr>)<br>/g, '$1');

  // 13) Restore code blocks
  codeBlocks.forEach((block, i) => {
    s = s.replace(`%%CODEBLOCK_${i}%%`, block);
  });

  return s;
}

/* ── Syntax highlighter (offline, no external lib needed) ── */
function highlightCode(code, lang) {
  let escaped = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  
  // Keywords for common languages
  const keywords = {
    js: /\b(const|let|var|function|return|if|else|for|while|class|import|export|from|async|await|try|catch|throw|new|this|typeof|switch|case|break|default|continue|do|in|of|yield|static|extends|super)\b/g,
    javascript: /\b(const|let|var|function|return|if|else|for|while|class|import|export|from|async|await|try|catch|throw|new|this|typeof|switch|case|break|default|continue|do|in|of|yield|static|extends|super)\b/g,
    python: /\b(def|class|import|from|return|if|elif|else|for|while|try|except|finally|with|as|in|not|and|or|is|None|True|False|pass|break|continue|raise|yield|lambda|global|nonlocal|assert|del|print|self)\b/g,
    py: /\b(def|class|import|from|return|if|elif|else|for|while|try|except|finally|with|as|in|not|and|or|is|None|True|False|pass|break|continue|raise|yield|lambda|global|nonlocal|assert|del|print|self)\b/g,
    html: /\b(html|head|body|div|span|class|id|style|script|link|meta|title|src|href|rel|type)\b/g,
    css: /\b(color|background|margin|padding|border|display|flex|grid|font|width|height|position|top|left|right|bottom|z-index|overflow|transition|transform|opacity|animation|align|justify)\b/g,
    json: /("(?:[^"\\]|\\.)*")\s*:/g,
    sql: /\b(SELECT|FROM|WHERE|INSERT|UPDATE|DELETE|CREATE|DROP|ALTER|TABLE|INDEX|JOIN|LEFT|RIGHT|INNER|OUTER|ON|AND|OR|NOT|NULL|INTO|VALUES|SET|ORDER|BY|GROUP|HAVING|LIMIT|DISTINCT|AS|UNION|BETWEEN|LIKE|IN|EXISTS|COUNT|SUM|AVG|MAX|MIN)\b/gi,
  };

  const kw = keywords[lang] || keywords['js'];
  
  // Apply highlighting
  // Strings
  escaped = escaped.replace(/(["'])(?:(?!\1|\\).|\\.)*\1/g, '<x c="hl-string">$&</x>');
  // Comments (single-line)
  escaped = escaped.replace(/(\/\/.*$|#.*$)/gm, '<x c="hl-comment">$&</x>');
  // Numbers
  escaped = escaped.replace(/\b(\d+\.?\d*)\b/g, '<x c="hl-number">$1</x>');
  // Keywords
  if (kw) {
    escaped = escaped.replace(kw, '<x c="hl-keyword">$&</x>');
  }
  
  return escaped;
}
