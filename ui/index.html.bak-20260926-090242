<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Expo Design AI</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
</style>
<style>
  :root{
    --bg: #09090b; --bg2: #18181b; --panel: #27272a; --panel2: #3f3f46; --border: #3f3f46;
    --text: #f4f4f5; --muted: #a1a1aa; --accent: #6366f1; --accent2: #8b5cf6;
    --radius: 12px; --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --preview-w: 600px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--font);overflow:hidden;font-size:14px;}

  body::before{
    content:'';position:fixed;inset:0;
    background:
      radial-gradient(circle at 50% 0%, rgba(99,102,241,0.08), transparent 50%),
      radial-gradient(circle at 100% 100%, rgba(139,92,246,0.05), transparent 40%);
    pointer-events:none;z-index:0
  }

  .app{display:grid;grid-template-columns:260px 1fr;height:100vh;position:relative;z-index:1}
  .app.preview-open{grid-template-columns:260px 1fr 4px var(--preview-w)}

  /* SIDEBAR */
  .sidebar{background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:16px;gap:16px;overflow:hidden}
  .brand{display:flex;align-items:center;gap:12px;padding-bottom:16px;border-bottom:1px solid var(--border)}
  .brand-logo{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:grid;place-items:center;font-weight:700;color:#fff;font-size:16px;box-shadow:0 4px 12px rgba(99,102,241,0.3)}
  .brand-text h1{font-size:15px;font-weight:600;letter-spacing:-0.2px}
  .brand-text span{font-size:11px;color:var(--muted);font-weight:500;letter-spacing:0.5px;text-transform:uppercase}

  .new-chat-btn{background:var(--text);color:var(--bg);border:none;padding:10px 14px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:8px}
  .new-chat-btn:hover{opacity:0.9;transform:translateY(-1px)}

  .proj-header{display:flex;align-items:center;justify-content:space-between;padding:8px 4px 4px;cursor:pointer}
  .proj-header .label{font-size:11px;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);font-weight:600}
  .proj-header .add{width:20px;height:20px;border-radius:5px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;font-size:14px;display:grid;place-items:center;transition:all 0.2s}
  .proj-header .add:hover{color:var(--text);border-color:var(--text)}

  .proj-item{padding:8px 12px;border-radius:6px;font-size:13px;color:var(--muted);cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.2s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}
  .proj-item:hover{background:var(--panel);color:var(--text)}
  .proj-item.active{background:var(--panel);color:var(--text);font-weight:600}
  .proj-item svg{flex-shrink:0;opacity:0.7}

  .history{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:4px;padding-right:4px}
  .history-item{padding:8px 12px;border-radius:6px;font-size:13px;color:var(--muted);cursor:pointer;display:flex;align-items:center;gap:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;position:relative;transition:all 0.2s;font-weight:500}
  .history-item:hover{background:var(--panel);color:var(--text)}
  .history-item.active{background:var(--panel);color:var(--text);font-weight:600}
  .history-item .ti{flex:1;overflow:hidden;text-overflow:ellipsis}
  .history-item .del{opacity:0;font-size:16px;color:var(--muted);transition:all 0.2s;line-height:1}
  .history-item:hover .del{opacity:1}
  .history-item .del:hover{color:#ef4444}
  .history-item svg{flex-shrink:0;opacity:0.7}

  .sidebar-footer{border-top:1px solid var(--border);padding-top:16px;margin-top:auto}
  .model-status{display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px}
  .status-dot{width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 8px rgba(16,185,129,0.4);animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}
  .model-status .name{font-weight:600;font-size:12px}
  .model-status .sub{font-size:11px;color:var(--muted);margin-top:2px}

  /* MAIN */
  .main{display:flex;flex-direction:column;height:100vh;overflow:hidden;background:transparent}
  .topbar{height:64px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex-shrink:0}
  .topbar-title{font-size:14px;font-weight:600;display:flex;align-items:center;gap:12px}
  .topbar-badge{font-size:10px;padding:4px 8px;border-radius:4px;background:var(--panel);color:var(--muted);border:1px solid var(--border);font-weight:600;letter-spacing:0.5px;text-transform:uppercase}
  .mode-pill{font-size:11px;padding:5px 12px;border-radius:12px;background:var(--panel);color:var(--text);border:1px solid var(--border);font-weight:500;cursor:pointer;user-select:none;transition:all 0.2s;display:inline-flex;align-items:center;gap:6px}
  .mode-pill:hover{background:var(--panel2)}
  .mode-pill.cowork{background:var(--accent);color:#fff;border-color:var(--accent)}

  .topbar-actions{display:flex;gap:12px}
  .icon-btn{width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:var(--bg2);color:var(--muted);cursor:pointer;display:grid;place-items:center;transition:all 0.2s}
  .icon-btn:hover{color:var(--text);border-color:var(--panel2);background:var(--panel)}
  .icon-btn.active{background:var(--panel);border-color:var(--accent);color:var(--accent)}

  /* CHAT */
  .chat{flex:1;overflow-y:auto;padding:32px 24px;display:flex;flex-direction:column;gap:24px;scroll-behavior:smooth}
  .chat::-webkit-scrollbar,.history::-webkit-scrollbar{width:5px}
  .chat::-webkit-scrollbar-thumb,.history::-webkit-scrollbar-thumb{background:var(--panel2);border-radius:4px}

  .msg{display:flex;gap:16px;max-width:860px;margin:0 auto;width:100%;animation:fadeIn 0.3s ease}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

  .msg.user{flex-direction:row-reverse}

  .avatar{width:32px;height:32px;border-radius:8px;flex-shrink:0;display:grid;place-items:center;font-size:13px;font-weight:600}
  .msg.user .avatar{background:var(--panel);color:var(--text);border:1px solid var(--border)}
  .msg.ai .avatar{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff}

  .bubble{padding:0;font-size:14.5px;line-height:1.6;max-width:calc(100% - 60px);word-wrap:break-word;color:var(--text)}
  .msg.user .bubble{background:var(--panel);padding:12px 18px;border-radius:12px;border:1px solid var(--border);color:var(--text)}
  .msg.ai .bubble{padding:6px 0}
  .msg-col{display:flex;flex-direction:column;gap:5px;min-width:0;max-width:calc(100% - 56px)}
  .msg.user .msg-col{align-items:flex-end}
  .msg-meta{display:flex;align-items:center;gap:8px;font-size:12px;line-height:1}
  .msg.user .msg-meta{flex-direction:row-reverse}
  .msg-role{font-weight:600;color:var(--text)}
  .msg-time{color:var(--muted);font-size:11px}
  .msg-col .bubble{max-width:100%}

  .bubble pre{background:#1a1b26;border:1px solid var(--border);padding:0;border-radius:10px;overflow:hidden;margin:12px 0;font-size:13px}
  .bubble pre code{display:block;padding:16px;overflow-x:auto;font-family:'JetBrains Mono', Consolas, 'Courier New', monospace;font-size:13px;line-height:1.6;background:transparent;color:#c0caf5}
  .bubble .code-block{position:relative}
  .bubble .code-header{display:flex;align-items:center;justify-content:space-between;padding:6px 16px;background:#15161e;border-bottom:1px solid #2a2b3d;font-size:11px}
  .bubble .code-lang{color:#7aa2f7;font-weight:600;letter-spacing:0.5px;font-family:var(--font)}
  .bubble code.inline-code{font-family:'JetBrains Mono', Consolas, monospace;font-size:12.5px;background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(139,92,246,0.15));color:#a78bfa;padding:2px 7px;border-radius:5px;border:1px solid rgba(139,92,246,0.2)}
  .bubble p{margin-bottom:12px}
  .bubble p:last-child{margin-bottom:0}
  .bubble ul, .bubble ol {margin-bottom:12px; padding-left:24px;}
  .bubble li {margin-bottom:6px; line-height:1.5;}
  .bubble li::marker {color:var(--accent);}
  .bubble blockquote {border-left:3px solid var(--accent); padding:8px 16px; color:var(--muted); margin:12px 0; background:rgba(99,102,241,0.05); border-radius:0 8px 8px 0;}
  .bubble table {width:100%; border-collapse:collapse; margin:12px 0; border-radius:8px; overflow:hidden;}
  .bubble th {background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.2)); color:#a78bfa; padding:10px 14px; text-align:left; font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; border:1px solid var(--border);}
  .bubble td {border:1px solid var(--border); padding:8px 14px; text-align:left;}
  .bubble tr:hover td {background:rgba(99,102,241,0.05);}
  .bubble h1 {font-size:22px; margin:20px 0 10px 0; font-weight:700; color:#e2e4f0; border-bottom:2px solid var(--accent); padding-bottom:8px;}
  .bubble h2 {font-size:18px; margin:18px 0 8px 0; font-weight:600; color:#c0caf5;}
  .bubble h3 {font-size:15px; margin:16px 0 6px 0; font-weight:600; color:#7aa2f7;}
  .bubble h4 {font-size:14px; margin:12px 0 4px 0; font-weight:600; color:#bb9af7;}
  .bubble strong {color:#e2e8f0; font-weight:600;}
  .bubble em {color:#7dcfff; font-style:italic;}
  .bubble hr {border:none; border-top:1px solid var(--border); margin:16px 0;}
  .bubble a {color:var(--accent); text-decoration:underline; text-underline-offset:2px;}
  .bubble a:hover {color:var(--accent2);}

  /* ── Syntax highlighting colors (Tokyo Night theme) ── */
  .bubble x[c="hl-keyword"] {color:#bb9af7; font-weight:500;}
  .bubble x[c="hl-string"] {color:#9ece6a;}
  .bubble x[c="hl-number"] {color:#ff9e64;}
  .bubble x[c="hl-comment"] {color:#565f89; font-style:italic;}
  .bubble x[c="hl-function"] {color:#7aa2f7;}
  .bubble x[c="hl-type"] {color:#2ac3de;}

  .cursor-blink{display:inline-block;width:6px;height:14px;background:var(--accent);margin-left:4px;vertical-align:middle;animation:blink 1s infinite}
  @keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}

  /* ARTIFACTS */
  .artifact-card{margin:16px 0;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg2)}
  .artifact-header{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:var(--panel);border-bottom:1px solid var(--border)}
  .artifact-header .title{font-size:12px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:8px;text-transform:uppercase;letter-spacing:0.5px}
  .artifact-actions{display:flex;gap:8px}
  .artifact-btn{font-size:12px;padding:6px 12px;border-radius:6px;border:1px solid var(--border);background:var(--bg2);color:var(--text);cursor:pointer;font-weight:500;transition:all 0.2s;display:inline-flex;align-items:center;gap:6px}
  .artifact-btn:hover{background:var(--panel)}
  .artifact-btn.primary{background:var(--text);color:var(--bg);border:none}
  .artifact-btn.primary:hover{opacity:0.9}

  /* WELCOME SCREEN */
  .welcome{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:32px;padding:40px 24px;text-align:center;max-width:700px;margin:0 auto}
  .welcome-logo{width:64px;height:64px;border-radius:16px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:grid;place-items:center;font-size:28px;font-weight:700;color:#fff;box-shadow:0 8px 24px rgba(99,102,241,0.25)}
  .welcome h2{font-size:28px;font-weight:600;letter-spacing:-0.5px;color:var(--text)}
  .welcome p{color:var(--muted);font-size:15px;line-height:1.5}

  .suggestions{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;width:100%}
  .suggestion{padding:16px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;cursor:pointer;text-align:left;transition:all 0.2s}
  .suggestion:hover{border-color:var(--muted);background:var(--panel)}
  .suggestion .icon{margin-bottom:10px;color:var(--accent)}
  .suggestion .title{font-size:14px;font-weight:600;margin-bottom:4px;color:var(--text)}
  .suggestion .desc{font-size:13px;color:var(--muted)}

  /* INPUT AREA */
  .input-area{padding:16px 24px 24px;background:transparent;flex-shrink:0}
  .input-wrap{max-width:860px;margin:0 auto;background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:12px 16px;display:flex;align-items:flex-end;gap:12px;transition:all 0.2s;box-shadow:0 8px 24px rgba(0,0,0,0.2)}
  .input-wrap:focus-within{border-color:var(--muted)}

  #input{flex:1;background:transparent;border:none;color:var(--text);font-family:var(--font);font-size:15px;resize:none;outline:none;max-height:200px;padding:4px 0;line-height:1.5}
  #input::placeholder{color:var(--muted)}

  .input-actions{display:flex;gap:8px;padding-bottom:2px}
  .attach-btn,.send-btn{width:32px;height:32px;border-radius:8px;cursor:pointer;display:grid;place-items:center;transition:all 0.2s;border:none}
  .attach-btn{background:transparent;color:var(--muted)}
  .attach-btn:hover{color:var(--text);background:var(--panel)}
  .send-btn{background:var(--text);color:var(--bg)}
  .send-btn:hover:not(:disabled){opacity:0.9;transform:scale(1.05)}
  .send-btn:disabled{opacity:0.5;cursor:not-allowed}
  .input-wrap{flex-direction:column;align-items:stretch;gap:8px}
  .composer-row{display:flex;align-items:flex-end;gap:10px;width:100%}
  .plus-wrap{position:relative;flex-shrink:0}
  .plus-btn{width:32px;height:32px;border-radius:8px;cursor:pointer;display:grid;place-items:center;border:none;background:transparent;color:var(--muted);transition:all .2s}
  .plus-btn:hover{color:var(--text);background:var(--panel)}
  .plus-menu{position:absolute;bottom:42px;left:0;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:6px;min-width:235px;box-shadow:0 12px 32px rgba(0,0,0,0.4);z-index:50}
  .plus-menu[hidden]{display:none}
  .plus-menu button{display:flex;align-items:center;gap:10px;width:100%;background:transparent;border:none;color:var(--text);font-family:var(--font);font-size:13px;padding:9px 10px;border-radius:8px;cursor:pointer;text-align:left}
  .plus-menu button:hover{background:var(--panel)}
  .attach-chips{display:flex;flex-wrap:wrap;gap:8px;width:100%}
  .attach-chips:empty{display:none}
  .chip{display:flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:6px 8px;font-size:12px;max-width:240px}
  .chip img{width:28px;height:28px;object-fit:cover;border-radius:6px;flex-shrink:0}
  .chip .chip-ic{width:26px;height:26px;border-radius:6px;display:grid;place-items:center;background:var(--bg2);flex-shrink:0;font-size:9px;font-weight:700;color:var(--muted)}
  .chip .chip-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
  .chip .chip-x{cursor:pointer;color:var(--muted);flex-shrink:0;line-height:1;font-size:13px}
  .chip .chip-x:hover{color:var(--text)}
  .input-wrap.dragover{border-color:var(--text)}

  .input-footer{max-width:860px;margin:12px auto 0;text-align:center;font-size:12px;color:var(--muted)}

  .typing{display:flex;gap:6px;padding:8px 0}
  .typing span{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:bounce 1.4s infinite}
  .typing span:nth-child(2){animation-delay:0.2s}
  .typing span:nth-child(3){animation-delay:0.4s}

  /* RESIZER + PREVIEW */
  .resizer{display:none;background:var(--border);cursor:col-resize;position:relative;z-index:10;transition:background 0.2s}
  .app.preview-open .resizer{display:block}
  .resizer:hover{background:var(--accent)}

  .preview-pane{background:#fff;display:none;flex-direction:column;overflow:hidden;min-width:320px;color:#000}
  .app.preview-open .preview-pane{display:flex}
  .preview-header{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid #e5e7eb;flex-shrink:0;background:#f9fafb}
  .preview-header .ptitle{font-size:13px;font-weight:600;display:flex;align-items:center;gap:10px;color:#111827}
  .preview-header .ptitle .dot{width:8px;height:8px;border-radius:50%;background:#10b981}

  .preview-actions{display:flex;gap:8px}
  .preview-actions .icon-btn{background:transparent;border:1px solid #d1d5db;color:#4b5563;border-radius:6px;width:30px;height:30px}
  .preview-actions .icon-btn:hover{background:#e5e7eb;color:#111827}

  .preview-frame{flex:1;background:#fff;border:none;width:100%}
  .preview-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:40px;text-align:center;color:#6b7280;font-size:14px}
  .preview-empty .ico{opacity:0.3}

  @media(max-width:1100px){.app.preview-open{grid-template-columns:260px 1fr}.resizer,.preview-pane{display:none!important}}
  @media(max-width:760px){.app,.app.preview-open{grid-template-columns:1fr}.sidebar{display:none}.suggestions{grid-template-columns:1fr}.welcome h2{font-size:24px}}
</style>
</head>
<body>
<div class="app" id="app">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-logo">E</div>
      <div class="brand-text"><h1>Expo Design AI</h1><span>Local &bull; Offline</span></div>
    </div>

    <button class="new-chat-btn" onclick="newChat()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      New Chat
    </button>
    <div style="display:flex;gap:6px;margin-top:8px">
      <button id="uploadBtn" onclick="pickUpload()" style="display:none;flex:1;background:#3b82f6;color:#fff;border:none;border-radius:9px;padding:8px;font-size:12px;font-weight:600;cursor:pointer">Upload files</button>
      <button id="docsBtn" onclick="openDocs()" style="flex:1;background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:9px;padding:8px;font-size:12px;cursor:pointer">Documents</button>
    </div>
    <input type="file" id="directUpload" hidden multiple onchange="uploadDirect(this)">

    <div class="proj-header">
      <div class="label">Projects</div>
      <button class="add" onclick="createProject()" title="New Project">+</button>
    </div>
    <div id="projList" style="max-height:140px;overflow-y:auto;display:flex;flex-direction:column;gap:2px"></div>

    <div class="proj-header" style="margin-top:6px; margin-bottom:4px">
      <div class="label">Knowledge Base</div>
      <button class="add" onclick="clearDocs()" title="Clear Docs for Current Project" style="border:none;background:transparent;cursor:pointer;">&#128465;</button>
    </div>
    <div id="kbList" style="display:flex;flex-direction:column;gap:1px;max-height:200px;overflow-y:auto;margin-bottom:4px"></div>

    <div class="proj-header" style="margin-top:6px">
      <div class="label">Recent Chats</div>
    </div>
    <div class="history" id="historyList"></div>

    <div class="sidebar-footer">
      <div class="model-status">
        <div class="status-dot"></div>
        <div><div class="name" id="footerModel">qwen3.8:27b</div><div class="sub">Ollama &bull; High Reasoning</div></div>
      </div>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="topbar-title">
        Expo Design AI
        <span class="topbar-badge">Offline Mode</span>
        <span class="mode-pill" id="modePill" onclick="toggleCowork()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Chat
        </span>
        <span class="mode-pill" id="typesafePill" onclick="toggleTypesafe()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Typesafe AI
        </span>
        <select id="modelSelect" onchange="document.getElementById('footerModel').textContent = this.value;" style="background:var(--panel); color:var(--text); border:1px solid var(--border); border-radius:6px; padding:4px 8px; font-size:12px; margin-left:10px; outline:none; font-family:var(--font); cursor:pointer;">
          <option value="qwen3.8:27b">qwen3.8:27b (Fast Reasoning)</option>
        </select>
