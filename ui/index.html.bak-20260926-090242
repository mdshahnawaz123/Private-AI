async function loadProjects() {
  try {
    const r = await fetch(`${API}/projects`);
    if (r.status === 401) { clearToken(); showLogin(); return; }
    projectsData = await r.json();
    if (currentUser && currentUser.role === 'admin' && !projectsData['default']) projectsData['default'] = [];
    if (!projectsData[currentProject]) { const ks = Object.keys(projectsData); currentProject = ks.length ? ks[0] : 'default'; }
    renderProjects();
    renderHistory();
    loadKbList();
  } catch (e) {
    console.warn('Projects load failed:', e);
    projectsData = {};
    renderProjects();
    renderHistory();
  }
}

function renderProjects() {
  projList.innerHTML = '';
  Object.keys(projectsData).forEach(name => {
    const el = document.createElement('div');
    el.className = 'proj-item' + (name === currentProject ? ' active' : '');
    el.innerHTML = `${ICONS.folder} <span>${escapeHtml(name)}</span>`;
    el.onclick = () => {
      currentProject = name;
      currentChatId = null;
      renderProjects();
      renderHistory();
      loadKbList();
    };
    projList.appendChild(el);
  });
}

function renderHistory() {
  historyList.innerHTML = '';
  const chats = projectsData[currentProject] || [];
  if (chats.length === 0) {
    historyList.innerHTML = `<div style="padding:10px 12px;font-size:12px;color:var(--muted)">No chats yet</div>`;
    return;
  }
  chats.slice().reverse().forEach(cid => {
    const el = document.createElement('div');
    el.className = 'history-item' + (cid === currentChatId ? ' active' : '');
    const displayTitle = cid.replace(/^chat-/, '').replace(/-/g, ' ');
    el.innerHTML = `${ICONS.chat} <span class="ti">${escapeHtml(displayTitle)}</span><span class="del" title="Delete">&times;</span>`;
    el.onclick = async (e) => {
      if (e.target.classList.contains('del')) {
        e.stopPropagation();
        await deleteChat(cid);
        return;
      }
      await openChat(cid);
    };
    historyList.appendChild(el);
  });
}

function createProject() {
  const name = prompt('Project name:');
  if (!name) return;
  const clean = name.trim().replace(/[^a-zA-Z0-9_\- ]/g, '').replace(/\s+/g, '-');
  if (!clean) return;
  currentProject = clean;
  if (!projectsData[clean]) projectsData[clean] = [];
  renderProjects();
  renderHistory();
}

async function openChat(chatId) {
  try {
    const r = await fetch(`${API}/projects/${currentProject}/${chatId}`);
    if (!r.ok) throw new Error('Not found');
    const data = await r.json();
    currentChatId = chatId;
    currentMessages = data.messages || [];
    chatEl.innerHTML = '';
    welcomeEl.style.display = 'none';
    for (const m of currentMessages) {
      appendMessage(m.role, m.content, false);
    }
    renderHistory();
    chatEl.scrollTop = chatEl.scrollHeight;
  } catch (e) {
    alert('Could not load chat: ' + e.message);
  }
}

async function deleteChat(chatId) {
  if (!confirm('Delete this chat?')) return;
  try {
    await fetch(`${API}/projects/${currentProject}/${chatId}`, { method: 'DELETE' });
    projectsData[currentProject] = projectsData[currentProject].filter(c => c !== chatId);
    if (currentChatId === chatId) newChat();
    renderHistory();
  } catch (e) {
    alert('Delete failed: ' + e.message);
  }
}

async function clearDocs() {
  if (!confirm(`Clear all indexed documents for project "${currentProject}"?`)) return;
  try {
    const res = await fetch(`${API}/projects/${currentProject}/docs`, { method: 'DELETE' });
    if (!res.ok) throw new Error(await res.text());
    alert('Knowledge Base cleared successfully!');
  } catch (e) {
    alert('Failed to clear docs: ' + e.message);
  }
}

async function saveChat() {
  if (!currentChatId) {
    currentChatId = `chat-${Date.now()}`;
  }
  try {
    await fetch(`${API}/projects/save`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        project: currentProject,
        chat_id: currentChatId,
        title: currentMessages[0]?.content?.slice(0, 40) || 'Untitled',
        messages: currentMessages
      })
    });
    if (!projectsData[currentProject].includes(currentChatId)) {
      projectsData[currentProject].push(currentChatId);
    }
    renderHistory();
  } catch (e) {
    console.warn('Save failed:', e);
  }
}

