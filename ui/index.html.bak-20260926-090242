<script>
/* ============================================================
   CONFIG
   ============================================================ */
const API = window.location.origin;   // always talk to the port the page is served from

/* ============================================================
   AUTH (Phase 5): token, login gate, role-aware UI
   ============================================================ */
let authToken = null, currentUser = null;
try { authToken = localStorage.getItem('expo_token') || null; } catch(e) {}
const _origFetch = window.fetch.bind(window);
window.fetch = function(url, opts){
  opts = opts || {};
  try {
    const u = (typeof url === 'string') ? url : (url && url.url) || '';
    if (authToken && (u.indexOf(API) === 0 || u.charAt(0) === '/')) {
      const h = new Headers(opts.headers || {});
      if (!h.has('Authorization')) h.set('Authorization', 'Bearer ' + authToken);
      opts = Object.assign({}, opts, { headers: h });
    }
  } catch(e) {}
  return _origFetch(url, opts);
};
function saveToken(t){ authToken = t; try { localStorage.setItem('expo_token', t); } catch(e) {} }
function clearToken(){ authToken = null; try { localStorage.removeItem('expo_token'); } catch(e) {} }
function showLogin(){
  const o = document.getElementById('loginOverlay'); if (o) o.style.display = 'flex';
  const b = document.getElementById('authBar'); if (b) b.style.display = 'none';
}
function onAuthed(){
  const o = document.getElementById('loginOverlay'); if (o) o.style.display = 'none';
  const b = document.getElementById('authBar'); if (b) b.style.display = 'flex';
  const who = document.getElementById('authWho'); if (who) who.textContent = currentUser.username + ' (' + currentUser.role + ')';
  const ab = document.getElementById('adminBtn'); if (ab) ab.style.display = (currentUser.role === 'admin') ? '' : 'none';
  const nb = document.getElementById('newProjBtn'); if (nb) nb.style.display = (currentUser.role === 'admin' || currentUser.role === 'lead') ? '' : 'none';
  const plus = document.getElementById('plusBtn'); if (plus) plus.style.display = (currentUser.role === 'user') ? 'none' : '';
  const ub = document.getElementById('uploadBtn'); if (ub) ub.style.display = (currentUser.role === 'user') ? 'none' : '';
  const dub = document.getElementById('docsUploadBtn'); if (dub) dub.style.display = (currentUser.role === 'user') ? 'none' : '';
  loadProjects();
}
async function initAuth(){
  if (!authToken) { showLogin(); return; }
  try {
    const r = await _origFetch(`${API}/auth/me`, { headers: { 'Authorization': 'Bearer ' + authToken } });
    if (!r.ok) throw new Error('unauth');
    const d = await r.json();
    currentUser = d.user; onAuthed();
  } catch(e) { clearToken(); showLogin(); }
}
async function doLogin(){
  const user = document.getElementById('lgUser').value.trim();
  const pass = document.getElementById('lgPass').value;
  const err = document.getElementById('loginErr'); err.textContent = '';
  try {
    const r = await _origFetch(`${API}/auth/login`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ username:user, password:pass }) });
    const d = await r.json();
    if (!r.ok) throw new Error(d.detail || 'Login failed');
    saveToken(d.token); currentUser = d.user; onAuthed();
  } catch(e) { err.textContent = e.message || 'Login failed'; }
}
function logout(){ clearToken(); currentUser = null; location.reload(); }
/* ===== Document library (upload button, documents tab, preview) ===== */
let _toastTimer = null;
function toast(msg, sticky){
  let t = document.getElementById('toast');
  if (!t){ t = document.createElement('div'); t.id = 'toast'; document.body.appendChild(t); }
  t.textContent = msg; t.className = 'show';
  if (_toastTimer) clearTimeout(_toastTimer);
  if (!sticky) _toastTimer = setTimeout(() => { t.className = ''; }, 2600);
}
function pickUpload(){
  if (!currentUser || currentUser.role === 'user'){ toast('You do not have upload permission'); return; }
  if (!currentProject){ toast('Select a project first'); return; }
  document.getElementById('directUpload').click();
}
async function uploadDirect(input){
  const files = [...input.files]; input.value = '';
  if (!files.length) return;
  const disc = (document.getElementById('disciplineSelect') || {}).value || '';
  let firstRel = null, firstName = null;
  for (const f of files){
    toast('Uploading ' + f.name + ' ...', true);
    const fd = new FormData(); fd.append('file', f); fd.append('project', currentProject);
    if (disc) fd.append('discipline', disc);
    try {
      const r = await fetch(`${API}/upload`, { method: 'POST', body: fd });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.detail || r.status);
      toast(f.name + ' - ' + (j.status === 'processing' ? 'processing in background' : (j.message || 'stored')));
      if (!firstRel){ firstRel = catSubdir(j.category) + '/' + f.name; firstName = f.name; }
    } catch(err){ toast('Failed: ' + f.name + ' - ' + err.message); }
  }
  openDocs(); startDocsPolling(); loadKbList();
  if (firstRel && isPreviewable(firstName)){ setTimeout(() => previewFile(encodeURIComponent(firstRel)), 300); }
}
function catSubdir(cat){ return (cat || 'Other').replace(/ /g, '-'); }
function isPreviewable(name){ return /\.(pdf|png|jpe?g|webp|gif|bmp)$/i.test(name || ''); }
let _docsPoll = null;
function startDocsPolling(){
  if (_docsPoll) clearInterval(_docsPoll);
  let ticks = 0;
  _docsPoll = setInterval(async () => {
    ticks++;
    if (!document.getElementById('docsPanel').classList.contains('open')){ clearInterval(_docsPoll); _docsPoll = null; return; }
    await loadDocuments(); loadKbList();
    const proc = (window._lastDocs || []).some(d => d.status === 'processing');
    if (!proc || ticks > 180){ clearInterval(_docsPoll); _docsPoll = null; }
  }, 3000);
}
async function viewData(enc){
  const rel = decodeURIComponent(enc);
  try {
    const r = await fetch(`${API}/projects/${encodeURIComponent(currentProject)}/document?rel=${encodeURIComponent(rel)}`);
    if (!r.ok){ toast('No structured data yet'); return; }
    const j = await r.json();
    const box = document.getElementById('previewBox');
    box.innerHTML = `<pre style='white-space:pre-wrap;color:#cbd5e1;font-size:12px;max-width:920px;margin:0 auto;text-align:left'>${escapeHtml(JSON.stringify(j, null, 2)).slice(0,300000)}</pre>`;
    document.getElementById('pvName').textContent = rel.split('/').pop() + ' - extracted data';
    document.getElementById('pvOpen').onclick = () => window.open(fileURL(rel), '_blank');
    document.getElementById('filePreview').classList.add('open');
  } catch(e){ toast('Could not load data'); }
}
function openDocs(){
  document.getElementById('docsPanel').classList.add('open');
  document.getElementById('docsTitle').textContent = 'Documents - ' + (currentProject || '');
  loadDocuments();
}
function closeDocs(){ document.getElementById('docsPanel').classList.remove('open'); }
function fileURL(rel){ return `${API}/projects/${encodeURIComponent(currentProject)}/file?rel=${encodeURIComponent(rel)}&token=${encodeURIComponent(authToken || '')}`; }
async function loadDocuments(){
  const body = document.getElementById('docsBody');
  body.innerHTML = '<div style="padding:20px;color:var(--muted)">Loading...</div>';
  try {
    const r = await fetch(`${API}/projects/${encodeURIComponent(currentProject)}/documents`);
    const d = await r.json();
    window._lastDocs = d.documents || [];
    renderDocuments(window._lastDocs);
  } catch(e){ body.innerHTML = '<div style="padding:20px;color:var(--muted)">Could not load documents.</div>'; }
}
const CAT_ORDER = ['Drawings','3D Models','Schedules','Reports','Images','Other'];
const CAT_ICON = {'Drawings':'&#128208;','3D Models':'&#129513;','Schedules':'&#128202;','Reports':'&#128196;','Images':'&#128444;','Other':'&#128193;'};
function fmtSize(n){ if (n == null) return ''; if (n < 1024) return n + ' B'; if (n < 1048576) return (n/1024).toFixed(0) + ' KB'; return (n/1048576).toFixed(1) + ' MB'; }
function renderDocuments(docs){
  const body = document.getElementById('docsBody');
  const canEdit = currentUser && currentUser.role !== 'user';
  if (!docs.length){
    body.innerHTML = '<div style="padding:26px;color:var(--muted)">No documents in this project yet.' + (canEdit ? ' Use the Upload button to add drawings, schedules, reports or 3D models.' : '') + '</div>';
    return;
  }
  const groups = {};
  docs.forEach(d => { (groups[d.category] = groups[d.category] || []).push(d); });
  let html = '';
  CAT_ORDER.forEach(cat => {
    const items = groups[cat]; if (!items || !items.length) return;
    html += `<div class="doc-cat"><div class="doc-cat-h">${CAT_ICON[cat] || ''} ${cat} <span class="doc-count">${items.length}</span></div><div class="doc-grid">`;
    items.forEach(f => {
      const ext = (f.filename.split('.').pop() || '').toLowerCase();
      const canPreview = /^(pdf|png|jpg|jpeg|webp|gif|bmp|xlsx|xls|csv|docx|doc|txt|dwg|dxf)$/.test(ext);
      const enc = encodeURIComponent(f.rel);
      let procTxt = 'Processing...';
      if (f.progress && f.progress.total) procTxt = 'Processing ' + f.progress.done + '/' + f.progress.total + (f.progress.stage ? ' (' + f.progress.stage + ')' : '');
      else if (f.progress && f.progress.stage) procTxt = f.progress.stage;
      const badge = f.status === 'processing' ? ("<span style='color:#fbbf24'>" + procTxt + "</span>") : (f.status === 'error' ? "<span style='color:#f87171'>Error</span>" : (f.indexed ? "<span style='color:#4ade80'>AI-indexed</span>" : 'stored'));
      html += `<div class="doc-card">
        <div class="doc-badge">${ext.toUpperCase().slice(0,4)}</div>
        <div class="doc-name" title="${escapeHtml(f.filename)}">${escapeHtml(f.filename)}</div>
        <div class="doc-meta">${fmtSize(f.size)} &middot; ${badge}</div>
        <div class="doc-actions">
          ${canPreview ? `<button class="doc-btn" onclick="previewFile('${enc}')">Preview</button>` : ''}
          ${f.hasData ? `<button class="doc-btn ghost" onclick="viewData('${enc}')">Data</button>` : ''}
          <button class="doc-btn ghost" onclick="openFile('${enc}')">Open</button>
        </div>
      </div>`;
    });
    html += '</div></div>';
  });
  body.innerHTML = html;
}
function openFile(enc){ window.open(fileURL(decodeURIComponent(enc)), '_blank'); }
async function fetchDocData(rel){
  try {
    const r = await fetch(`${API}/projects/${encodeURIComponent(currentProject)}/document?rel=${encodeURIComponent(rel)}`);
    if (!r.ok) return null;
    return await r.json();
  } catch(e){ return null; }
}
function _openPreview(rel, html){
  document.getElementById('previewBox').innerHTML = html;
  document.getElementById('pvName').textContent = rel.split('/').pop();
  document.getElementById('pvOpen').onclick = () => window.open(fileURL(rel), '_blank');
  document.getElementById('filePreview').classList.add('open');
}
async function previewFile(enc){
  const rel = decodeURIComponent(enc);
  const ext = (rel.split('.').pop() || '').toLowerCase();
  const url = fileURL(rel);
  if (/^(png|jpg|jpeg|webp|gif|bmp)$/.test(ext)){ _openPreview(rel, `<img src='${url}' style='max-width:100%;max-height:100%;object-fit:contain'>`); return; }
  if (ext === 'pdf'){ _openPreview(rel, `<iframe src='${url}' style='width:100%;height:100%;border:none;background:#fff'></iframe>`); return; }
  _openPreview(rel, "<div style='color:#9aa0aa;padding:20px'>Loading preview...</div>");
  const data = await fetchDocData(rel);
  if (!data){ _openPreview(rel, "<div class='pv-scroll' style='text-align:center;padding:40px'>No inline preview available for this file.<br>Use <b>Open original</b> to view it in its app.</div>"); return; }
  let html = '';
  if (data.type === 'excel' && data.sheets){
    html = data.sheets.map(sh => {
      const rows = (sh.rows || []).map((r, ri) => '<tr>' + r.map(c => (ri === 0 ? '<th>' : '<td>') + escapeHtml(c) + (ri === 0 ? '</th>' : '</td>')).join('') + '</tr>').join('');
      return `<div class='xl-title'>${escapeHtml(sh.sheet)}</div><table class='xl-table'>${rows}</table>`;
    }).join('');
  } else if (data.type === 'docx'){
    const paras = (data.paragraphs || []).map(x => '<p>' + escapeHtml(x) + '</p>').join('');
    const tbls = (data.tables || []).map(t => "<table class='xl-table'>" + t.map(r => '<tr>' + r.map(c => '<td>' + escapeHtml(c) + '</td>').join('') + '</tr>').join('') + '</table>').join('');
    html = `<div class='doc-view'>${paras}${tbls}</div>`;
  } else if (data.type === 'cad'){
    const dir = rel + '_render';
    const imgs = (data.views || []).map(v => `<img src='${fileURL(dir + '/' + v.image)}' style='max-width:100%;border:1px solid #ccc;border-radius:8px;margin:8px 0'>`).join('');
    html = `<div class='doc-view'>${imgs}${data.data ? '<pre>' + escapeHtml(data.data) + '</pre>' : ''}</div>`;
  } else {
    html = '<pre>' + escapeHtml(JSON.stringify(data, null, 2)).slice(0, 200000) + '</pre>';
  }
  _openPreview(rel, `<div class='pv-scroll'>${html}</div>`);
}
function closeFilePreview(){ document.getElementById('filePreview').classList.remove('open'); document.getElementById('previewBox').innerHTML = ''; }
async function loadKbList(){
  const el = document.getElementById('kbList');
  if (!el) return;
  if (!currentUser || currentUser.role !== 'admin'){ el.innerHTML = ''; return; }
  try {
    const r = await fetch(`${API}/projects/${encodeURIComponent(currentProject)}/documents`);
    if (!r.ok){ el.innerHTML = ''; return; }
    const d = await r.json();
    const docs = d.documents || [];
    if (!docs.length){ el.innerHTML = "<div style='font-size:11px;color:var(--muted);padding:3px 6px'>No files yet</div>"; return; }
    el.innerHTML = docs.map(f => {
      const enc = encodeURIComponent(f.rel);
      const dot = f.status === 'processing' ? '#fbbf24' : (f.status === 'error' ? '#f87171' : (f.indexed ? '#4ade80' : '#9aa0aa'));
      const prev = /\.(pdf|png|jpe?g|webp|gif|bmp|xlsx|xls|csv|docx|doc|txt|dwg|dxf)$/i.test(f.filename);
      const act = prev ? ("previewFile('" + enc + "')") : ("openFile('" + enc + "')");
      return "<div class='kb-item' title='" + escapeHtml(f.filename) + "' onclick=\"" + act + "\"><span class='kb-dot' style='background:" + dot + "'></span><span class='kb-name'>" + escapeHtml(f.filename) + "</span></div>";
    }).join('');
  } catch(e){ el.innerHTML = ''; }
}
function openAdmin(){ document.getElementById('adminModal').classList.add('open'); adminRefresh(); }
function fillSelect(sel, items, placeholder){
  if (!sel) return;
  const prev = sel.value;
  sel.innerHTML = '';
  if (placeholder){ const o=document.createElement('option'); o.value=''; o.textContent=placeholder; o.disabled=true; o.selected=true; sel.appendChild(o); }
  items.forEach(v => { const o=document.createElement('option'); o.value=v; o.textContent=v; if(v===prev) o.selected=true; sel.appendChild(o); });
}
async function adminRefresh(){
  const projs = Object.keys(projectsData || {}).filter(n => n.indexOf('__') !== 0);
  fillSelect(document.getElementById('amProj'), projs, projs.length ? 'Select a project' : 'No projects yet');
  try {
    const r = await fetch(`${API}/admin/users`); const d = await r.json();
    const users = d.users || [];
    fillSelect(document.getElementById('amUser'), users.filter(u => u.username !== 'system').map(u => u.username), 'Select a user');
    const rows = users.map(u => `<tr><td>${escapeHtml(u.username)}</td><td><span class="role-pill role-${u.role}">${u.role}</span></td><td>${u.is_active ? 'Active' : '<span style=\'color:#f87171\'>Inactive</span>'}</td></tr>`).join('');
    document.getElementById('userRows').innerHTML = rows || '<tr><td colspan="3" style="color:var(--muted)">No users yet</td></tr>';
  } catch(e) {}
}
function closeAdmin(){ document.getElementById('adminModal').classList.remove('open'); }
function setMsg(id, t, ok){ const e = document.getElementById(id); if (e){ e.textContent = t; e.style.color = ok ? '#4ade80' : '#f87171'; } }
async function adminCreateUser(){
  const body = { username: document.getElementById('nuUser').value.trim(), password: document.getElementById('nuPass').value, role: document.getElementById('nuRole').value };
