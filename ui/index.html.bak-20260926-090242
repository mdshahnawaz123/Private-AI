/* ============================================================
   STREAMING READER
   ============================================================ */
async function streamResponse(prompt, endpoint) {
  const typingEl = appendTyping();
  const msgEl = document.createElement('div');
  msgEl.className = 'msg ai';
  msgEl.innerHTML = `<div class="avatar">E</div><div class="msg-col"><div class="msg-meta"><span class="msg-role">Expo Design AI</span><span class="msg-time">${nowTime()}</span></div><div class="bubble" id="streamBubble"><span class="cursor-blink"></span></div></div>`;
  typingEl.replaceWith(msgEl);
  const bubble = msgEl.querySelector('#streamBubble');
  let fullText = '';

  abortController = new AbortController();

  const res = await fetch(endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ 
      query: prompt, 
      project: currentProject, 
      messages: currentMessages.slice(0, -1),
      k: 8,
      format: typesafeMode ? 'json' : 'text',
      model: document.getElementById('modelSelect').value,
      mode: coworkMode ? 'cowork' : 'chat',
      discipline: (document.getElementById('disciplineSelect') || {}).value || ''
    }),
    signal: abortController.signal
  });
  if (!res.ok) throw new Error('Stream failed: ' + res.status);

  const reader = res.body.getReader();
  const decoder = new TextDecoder();
  let buffer = '';

  try {
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n\n');
      buffer = lines.pop() || '';
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;
        try {
          const data = JSON.parse(line.slice(6));
          if (data.type === 'token') {
            fullText += data.text;
            bubble.innerHTML = formatText(fullText) + '<span class="cursor-blink"></span>';

          chatEl.scrollTop = chatEl.scrollHeight;
        } else if (data.type === 'done') {
          bubble.innerHTML = formatText(fullText);
        } else if (data.type === 'error') {
          bubble.innerHTML = `${ICONS.alert} <span style="color:#ef4444">${escapeHtml(data.message)}</span>`;
        }
      } catch (err) {
        console.warn('Parse error:', err, line);
      }
    }
  }
  } catch (e) {
    if (e.name === 'AbortError') {
      console.log('Stream aborted');
    } else {
      throw e;
    }
  }

  if (!fullText.trim()) fullText = '(no response)';
  currentMessages.push({ role: 'assistant', content: fullText });

  convertArtifacts(bubble, fullText);
  autoOpenArtifact(fullText);
  chatEl.scrollTop = chatEl.scrollHeight;
}

/* ============================================================
   MESSAGE RENDERING
   ============================================================ */
function nowTime(){ return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }
function appendMessage(role, text, animate = true) {
  const m = document.createElement('div');
  m.className = `msg ${role}`;
  if (!animate) m.style.animation = 'none';

  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  bubble.innerHTML = formatText(text);

  if (role === 'ai') convertArtifacts(bubble, text);

  const msgDl = document.createElement('button');
  msgDl.className = 'copy-msg-btn';
  msgDl.style.right = role === 'ai' ? '70px' : 'auto';
  msgDl.style.left  = role === 'user' ? '70px' : 'auto';
  msgDl.textContent = 'Download';
  msgDl.onclick = () => {
    const blob = new Blob([text], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'expo-response-' + Date.now() + '.txt';
    a.click();
  };
  const col = document.createElement('div');
  col.className = 'msg-col';
  const meta = document.createElement('div');
  meta.className = 'msg-meta';
  meta.innerHTML = `<span class="msg-role">${role === 'user' ? 'You' : 'Expo Design AI'}</span><span class="msg-time">${nowTime()}</span>`;
  col.appendChild(meta);
  col.appendChild(bubble);
  m.innerHTML = `<div class="avatar">${role === 'user' ? 'You' : 'E'}</div>`;
  m.appendChild(col);
  if (role === 'ai') m.appendChild(msgDl);
  chatEl.appendChild(m);
  chatEl.scrollTop = chatEl.scrollHeight;
}

function convertArtifacts(bubble, fullText) {
  const arts = extractArtifacts(fullText);
  let idx = 0;
  bubble.querySelectorAll('pre').forEach(pre => {
    const code = pre.querySelector('code');
    const raw = code ? code.textContent : '';
    const cls = code ? code.className : '';
    const lang = (arts[idx]?.lang) || (cls.replace('language-', '') || '').toLowerCase();
    if (['html', 'svg', 'javascript', 'js', 'css', 'json', 'python', 'py'].includes(lang)) {
      const card = document.createElement('div');
      card.className = 'artifact-card';

      const header = document.createElement('div');
      header.className = 'artifact-header';
      header.innerHTML = `<div class="title">${ICONS.zap} ${lang.toUpperCase()} Artifact</div>`;

      const actions = document.createElement('div');
      actions.className = 'artifact-actions';

      const openBtn = document.createElement('button');
      openBtn.className = 'artifact-btn primary';
      openBtn.innerHTML = `${ICONS.play} Preview`;
      openBtn.onclick = () => showPreview(raw, lang);

      const copyBtn = document.createElement('button');
      copyBtn.className = 'artifact-btn';
      copyBtn.innerHTML = `${ICONS.copy} Copy`;
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(raw);
        copyBtn.innerHTML = `${ICONS.check} Copied`;
        setTimeout(() => copyBtn.innerHTML = `${ICONS.copy} Copy`, 1500);
      };

      const dlBtn = document.createElement('button');
      dlBtn.className = 'artifact-btn';
      dlBtn.textContent = 'Download';
      dlBtn.onclick = () => {
        const ext = lang === 'svg' ? 'svg'
                  : lang === 'css' ? 'css'
                  : lang === 'json' ? 'json'
                  : (lang === 'python' || lang === 'py') ? 'py'
                  : (lang === 'javascript' || lang === 'js') ? 'js'
                  : 'html';
        const blob = new Blob([raw], { type: 'text/plain' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'expo-artifact-' + Date.now() + '.' + ext;
        a.click();
      };
      actions.appendChild(openBtn);
      actions.appendChild(copyBtn);
      actions.appendChild(dlBtn);
      header.appendChild(actions);
      card.appendChild(header);
      pre.replaceWith(card);
      card.appendChild(pre);
      idx++;
    }
  });
}

function autoOpenArtifact(text) {
  const arts = extractArtifacts(text);
  if (arts.length > 0) {
    const a = arts[0];
    if (['html', 'svg', 'javascript', 'js'].includes(a.lang)) {
      showPreview(a.code, a.lang);
    }
  }
}

function appendTyping() {
  const m = document.createElement('div');
  m.className = 'msg ai';
  m.innerHTML = '<div class="avatar">E</div><div class="bubble"><div class="typing"><span></span><span></span><span></span></div></div>';
  chatEl.appendChild(m);
  chatEl.scrollTop = chatEl.scrollHeight;
  return m;
}

/* ============================================================
   HELPERS
   ============================================================ */
function extractArtifacts(text) {
  const out = [];
  // Strip <think> tags for artifact extraction
  const cleanText = text.replace(/<think>[\s\S]*?<\/think>/g, '');
  
  const re = /```\s*(\w+)?\s*\r?\n([\s\S]*?)```/g;
  let m;
  while ((m = re.exec(cleanText))) out.push({ lang: (m[1] || 'text').toLowerCase(), code: m[2].trim() });
  
  // Fallback: if AI forgot backticks but output raw HTML
  if (out.length === 0 && (cleanText.includes('</div>') || cleanText.includes('</style>') || cleanText.includes('</svg>') || cleanText.includes('</html>'))) {
     out.push({ lang: 'html', code: cleanText.trim() });
  }
  
  return out;
}

function escapeHtml(s) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function formatText(text) {
  // ── Full inline markdown renderer (works 100% offline) ──

  let s = text;
  
  // 0) Handle <think> blocks (DeepSeek)
  s = s.replace(/<think>([\s\S]*?)<\/think>/g, (match, thinkContent) => {
    return `<div style="margin: 12px 0; padding: 12px 16px; background: rgba(255,255,255,0.03); border-left: 3px solid #6b7280; color: #9ca3af; font-size: 13px; font-style: italic; border-radius: 0 8px 8px 0;"><strong>Thinking Process:</strong><br>${escapeHtml(thinkContent).replace(/\n/g, '<br>')}</div>`;
  });
  // Handle unclosed <think> block (while streaming)
  s = s.replace(/<think>([\s\S]*)$/g, (match, thinkContent) => {
    return `<div style="margin: 12px 0; padding: 12px 16px; background: rgba(255,255,255,0.03); border-left: 3px solid #6b7280; color: #9ca3af; font-size: 13px; font-style: italic; border-radius: 0 8px 8px 0;"><strong>Thinking Process:</strong><br>${escapeHtml(thinkContent).replace(/\n/g, '<br>')}</div>`;
  });

  // Fallback: If AI output raw HTML without backticks, wrap it in backticks so it gets highlighted
  if (!s.includes('```') && (s.includes('</div>') || s.includes('</style>') || s.includes('</svg>') || s.includes('</html>'))) {
    s = '```html\n' + s.trim() + '\n```';
  }

  // 1) Extract code blocks first, replace with placeholders
  const codeBlocks = [];
  s = s.replace(/```\s*(\w+)?\s*\r?\n([\s\S]*?)```/g, (_, lang, code) => {
    const idx = codeBlocks.length;
    const highlighted = highlightCode(code.trim(), lang || 'text');
    codeBlocks.push(`<pre class="code-block"><div class="code-header"><span class="code-lang">${(lang || 'text').toUpperCase()}</span></div><code class="language-${lang || 'text'}">${highlighted}</code></pre>`);
    return `%%CODEBLOCK_${idx}%%`;
  });
  
  // Handle unclosed code block (while streaming)
  s = s.replace(/```\s*(\w+)?\s*\r?\n([\s\S]*)$/g, (_, lang, code) => {
    const idx = codeBlocks.length;
    const highlighted = highlightCode(code.trim(), lang || 'text');
    codeBlocks.push(`<pre class="code-block"><div class="code-header"><span class="code-lang">${(lang || 'text').toUpperCase()} (typing...)</span></div><code class="language-${lang || 'text'}">${highlighted}</code></pre>`);
    return `%%CODEBLOCK_${idx}%%`;
  });

  // 2) Escape HTML in remaining text
  s = s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // 3) Tables (must come before line-based processing)
  s = s.replace(/^(\|.+\|)\r?\n(\|[\s\-:|]+\|)\r?\n((?:\|.+\|\r?\n?)+)/gm, (match, header, sep, bodyBlock) => {
    const hCells = header.split('|').filter(c => c.trim());
    const rows = bodyBlock.trim().split('\n');
    let html = '<table><thead><tr>';
    hCells.forEach(c => html += `<th>${c.trim()}</th>`);
    html += '</tr></thead><tbody>';
    rows.forEach(row => {
      const cells = row.split('|').filter(c => c.trim());
      html += '<tr>';
      cells.forEach(c => html += `<td>${c.trim()}</td>`);
      html += '</tr>';
    });
    html += '</tbody></table>';
    return html;
  });

  // 4) Headers
  s = s.replace(/^#### (.+)$/gm, '<h4>$1</h4>');
  s = s.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  s = s.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  s = s.replace(/^# (.+)$/gm, '<h1>$1</h1>');

  // 5) Blockquotes
  s = s.replace(/^&gt; (.+)$/gm, '<blockquote>$1</blockquote>');

  // 6) Unordered lists
  s = s.replace(/(?:^|\n)((?:[\t ]*[-*] .+\n?)+)/g, (match, block) => {
    const items = block.trim().split('\n').map(line => {
      return '<li>' + line.replace(/^[\t ]*[-*] /, '') + '</li>';
    }).join('');
    return `<ul>${items}</ul>`;
  });

  // 7) Ordered lists
  s = s.replace(/(?:^|\n)((?:[\t ]*\d+\. .+\n?)+)/g, (match, block) => {
    const items = block.trim().split('\n').map(line => {
      return '<li>' + line.replace(/^[\t ]*\d+\. /, '') + '</li>';
    }).join('');
    return `<ol>${items}</ol>`;
  });

  // 8) Horizontal rules
  s = s.replace(/^---$/gm, '<hr>');

  // 9) Inline formatting
  s = s.replace(/\*\*\*([^*]+)\*\*\*/g, '<strong><em>$1</em></strong>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  s = s.replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>');

  // 10) Links
  s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" style="color:var(--accent)">$1</a>');

  // 11) Line breaks (convert remaining newlines, but not inside block elements)
  s = s.replace(/\n/g, '<br>');

  // 12) Clean up excessive <br> after block elements
  s = s.replace(/(<\/h[1-4]>)<br>/g, '$1');
  s = s.replace(/(<\/ul>)<br>/g, '$1');
  s = s.replace(/(<\/ol>)<br>/g, '$1');
  s = s.replace(/(<\/table>)<br>/g, '$1');
  s = s.replace(/(<\/blockquote>)<br>/g, '$1');
  s = s.replace(/(<\/pre>)<br>/g, '$1');
  s = s.replace(/(<hr>)<br>/g, '$1');

  // 13) Restore code blocks
  codeBlocks.forEach((block, i) => {
    s = s.replace(`%%CODEBLOCK_${i}%%`, block);
  });

  return s;
}

/* ── Syntax highlighter (offline, no external lib needed) ── */
function highlightCode(code, lang) {
  let escaped = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  
  // Keywords for common languages
  const keywords = {
    js: /\b(const|let|var|function|return|if|else|for|while|class|import|export|from|async|await|try|catch|throw|new|this|typeof|switch|case|break|default|continue|do|in|of|yield|static|extends|super)\b/g,
    javascript: /\b(const|let|var|function|return|if|else|for|while|class|import|export|from|async|await|try|catch|throw|new|this|typeof|switch|case|break|default|continue|do|in|of|yield|static|extends|super)\b/g,
    python: /\b(def|class|import|from|return|if|elif|else|for|while|try|except|finally|with|as|in|not|and|or|is|None|True|False|pass|break|continue|raise|yield|lambda|global|nonlocal|assert|del|print|self)\b/g,
    py: /\b(def|class|import|from|return|if|elif|else|for|while|try|except|finally|with|as|in|not|and|or|is|None|True|False|pass|break|continue|raise|yield|lambda|global|nonlocal|assert|del|print|self)\b/g,
    html: /\b(html|head|body|div|span|class|id|style|script|link|meta|title|src|href|rel|type)\b/g,
    css: /\b(color|background|margin|padding|border|display|flex|grid|font|width|height|position|top|left|right|bottom|z-index|overflow|transition|transform|opacity|animation|align|justify)\b/g,
    json: /("(?:[^"\\]|\\.)*")\s*:/g,
    sql: /\b(SELECT|FROM|WHERE|INSERT|UPDATE|DELETE|CREATE|DROP|ALTER|TABLE|INDEX|JOIN|LEFT|RIGHT|INNER|OUTER|ON|AND|OR|NOT|NULL|INTO|VALUES|SET|ORDER|BY|GROUP|HAVING|LIMIT|DISTINCT|AS|UNION|BETWEEN|LIKE|IN|EXISTS|COUNT|SUM|AVG|MAX|MIN)\b/gi,
  };

  const kw = keywords[lang] || keywords['js'];
  
  // Apply highlighting
  // Strings
  escaped = escaped.replace(/(["'])(?:(?!\1|\\).|\\.)*\1/g, '<x c="hl-string">$&</x>');
  // Comments (single-line)
  escaped = escaped.replace(/(\/\/.*$|#.*$)/gm, '<x c="hl-comment">$&</x>');
  // Numbers
  escaped = escaped.replace(/\b(\d+\.?\d*)\b/g, '<x c="hl-number">$1</x>');
  // Keywords
  if (kw) {
    escaped = escaped.replace(kw, '<x c="hl-keyword">$&</x>');
  }
  
  return escaped;
}
</script>
