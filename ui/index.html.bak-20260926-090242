 .docs-body{flex:1;overflow:auto;padding:20px 24px}
 .doc-cat{margin-bottom:22px}
 .doc-cat-h{font-size:12px;font-weight:650;letter-spacing:.04em;text-transform:uppercase;color:var(--muted,#9aa0aa);margin-bottom:10px;display:flex;align-items:center;gap:8px}
 .doc-count{background:var(--panel,#1b1f26);border-radius:999px;padding:1px 8px;font-size:11px;color:var(--muted,#9aa0aa)}
 .doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}
 .doc-card{background:var(--bg2,#15181d);border:1px solid var(--border,#2a2f37);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:8px}
 .doc-badge{width:38px;height:38px;border-radius:9px;background:rgba(59,130,246,.15);color:#93c5fd;display:grid;place-items:center;font-size:10px;font-weight:700}
 .doc-name{font-size:13px;color:var(--text,#e8eaed);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}
 .doc-meta{font-size:11px;color:var(--muted,#9aa0aa)}
 .doc-actions{display:flex;gap:6px;margin-top:4px}
 .doc-btn{flex:1;background:#3b82f6;color:#fff;border:none;border-radius:8px;padding:6px;font-size:12px;cursor:pointer}
 .doc-btn.ghost{background:var(--panel,#1b1f26);border:1px solid var(--border,#2a2f37);color:var(--text,#e8eaed)}
 #filePreview{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;flex-direction:column;z-index:1100}
 #filePreview.open{display:flex}
 #filePreview .pv-head{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;color:#fff;font-family:var(--font,system-ui);font-size:13px}
 #filePreview .pv-head button{background:rgba(255,255,255,.14);border:none;color:#fff;border-radius:8px;padding:6px 12px;cursor:pointer;font-size:13px;margin-left:8px}
 #previewBox{flex:1;display:flex;align-items:center;justify-content:center;padding:0 20px 22px;overflow:auto}
 .kb-item{display:flex;align-items:center;gap:8px;padding:4px 6px;border-radius:7px;cursor:pointer;font-size:12px;color:var(--muted,#9aa0aa)}
 .kb-item:hover{background:var(--panel,#1b1f26);color:var(--text,#e8eaed)}
 .kb-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
 .kb-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 #previewBox .pv-scroll{width:100%;height:100%;overflow:auto;background:#fff;border-radius:8px;padding:18px 22px;box-sizing:border-box;text-align:left}
 #previewBox .pv-scroll, #previewBox .pv-scroll *{color:#1a1a1a}
 #previewBox .xl-title{font-weight:700;margin:16px 0 6px;font-size:14px}
 #previewBox .xl-table{border-collapse:collapse;margin-bottom:18px;font-size:12px}
 #previewBox .xl-table th,#previewBox .xl-table td{border:1px solid #ccc;padding:4px 8px;text-align:left;white-space:nowrap}
 #previewBox .xl-table th{background:#f1f3f5;font-weight:700}
 #previewBox .doc-view{max-width:840px;margin:0 auto}
 #previewBox .doc-view p{margin:0 0 8px;line-height:1.55}
 #previewBox .pv-scroll pre{white-space:pre-wrap;font-size:12px}
</style>
<div class="docs-back" id="docsPanel">
 <div class="docs-head">
  <h3 id="docsTitle">Documents</h3>
  <div style="display:flex;gap:8px">
   <button class="doc-btn" id="docsUploadBtn" style="display:none;flex:none;padding:7px 16px" onclick="pickUpload()">Upload</button>
   <button class="doc-btn ghost" style="flex:none;padding:7px 16px" onclick="closeDocs()">Back to chat</button>
  </div>
 </div>
 <div class="docs-body" id="docsBody"></div>
</div>
<div id="filePreview">
 <div class="pv-head">
  <span id="pvName"></span>
  <span><button id="pvOpen">Open original</button><button onclick="closeFilePreview()">Close</button></span>
 </div>
 <div id="previewBox"></div>
</div>
</body>
</html>