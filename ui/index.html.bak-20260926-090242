function showPreview(code, lang) {
  currentArtifact = { code, lang };
  let html = code;
  if (lang === 'svg') {
    html = `<!DOCTYPE html><html><body style="margin:0;display:grid;place-items:center;height:100vh;background:#f5f5f7">${code}</body></html>`;
  } else if (lang === 'javascript' || lang === 'js') {
    html = `<!DOCTYPE html><html><body style="font-family:monospace;padding:20px;background:#09090b;color:#f4f4f5"><div id="out"></div><script>
      console.log=(...a)=>{document.getElementById('out').innerHTML+=a.map(x=>typeof x==='object'?JSON.stringify(x,null,2):String(x)).join(' ')+'<br>'};
      try{${code}}catch(e){document.getElementById('out').innerHTML+='<span style="color:#ef4444">Error: '+e.message+'</span>'}
    <\/script></body></html>`;
  } else if (['css', 'json', 'text', 'python', 'py'].includes(lang)) {
    html = `<!DOCTYPE html><html><body style="margin:0;padding:20px;background:#09090b;color:#f4f4f5;font-family:monospace;font-size:13px;white-space:pre-wrap">${escapeHtml(code)}</body></html>`;
  }
  frame.srcdoc = html;
  frame.style.display = 'block';
  emptyPrev.style.display = 'none';
  previewTitle.textContent = `Artifact (${lang || 'html'})`;
  if (!previewOpen) togglePreview();
}

function closePreview() {
  currentArtifact = null;
  frame.style.display = 'none';
  emptyPrev.style.display = 'flex';
  previewTitle.textContent = 'Live Preview';
}

function openPreviewTab() {
  if (!currentArtifact) return;
  const w = window.open('', '_blank');
  w.document.write(frame.srcdoc);
  w.document.close();
}

function downloadPreview() {
  if (!currentArtifact) return;
  const ext = currentArtifact.lang === 'svg' ? 'svg'
            : currentArtifact.lang === 'css' ? 'css'
            : currentArtifact.lang === 'json' ? 'json'
            : (currentArtifact.lang === 'python' || currentArtifact.lang === 'py') ? 'py'
            : 'html';
  const blob = new Blob([currentArtifact.code], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `expo-artifact.${ext}`;
  a.click();
}

