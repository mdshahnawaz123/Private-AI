let abortController = null;

async function sendMessage() {
  const text = inputEl.value.trim();
  if ((!text && !attachedFiles.length) || isStreaming) return;

  welcomeEl.style.display = 'none';
  const names = attachedFiles.map(f => f.name);
  const userText = text + (names.length ? `\n\nAttached: ${names.join(', ')}` : '');
  appendMessage('user', userText);
  currentMessages.push({ role: 'user', content: userText });

  inputEl.value = '';
  inputEl.style.height = 'auto';
  
  isStreaming = true;
  sendBtn.innerHTML = '&#9209;'; // Stop icon
  sendBtn.title = 'Stop Generating';
  sendBtn.onclick = () => {
    if (abortController) abortController.abort();
  };

  try {
    if (attachedFiles.length) {
      const disc = (document.getElementById('disciplineSelect') || {}).value || '';
      for (const f of attachedFiles) {
        const fd = new FormData();
        fd.append('file', f);
        fd.append('project', currentProject);
        if (disc) fd.append('discipline', disc);
        const ur = await fetch(`${API}/upload`, { method: 'POST', body: fd });
        if (!ur.ok) throw new Error('Upload failed for ' + f.name + ': ' + (await ur.text()));
      }
      attachedFiles = [];
      renderChips();
    }

    let prompt = text;
    if (coworkMode && currentArtifact) {
      prompt = `You are in COWORK mode. The user is iterating on an artifact.

CURRENT ARTIFACT (${currentArtifact.lang}):
\`\`\`${currentArtifact.lang}
${currentArtifact.code}
\`\`\`

USER REQUEST: ${text}

Return the COMPLETE updated artifact in a single fenced \`\`\`${currentArtifact.lang} code block.`;
    } else {
      prompt = text + "\n\nIMPORTANT: If your answer includes complete HTML, CSS+HTML, SVG, or runnable code, wrap the ENTIRE code in a fenced block with the language identifier (e.g. \`\`\`html ... \`\`\`). Make it a single self-contained document so it can be rendered live.";
    }

    const docsReady = await hasDocs();
    const endpoint = docsReady ? `${API}/ask_stream` : `${API}/ask_chat`;
    await streamResponse(prompt, endpoint);

    await saveChat();
  } catch (e) {
    if (e.name === 'AbortError') {
      appendMessage('ai', 'Generation stopped.');
    } else {
      appendMessage('ai', `Error: ${e.message}`);
    }
  }

  isStreaming = false;
  sendBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>`;
  sendBtn.title = 'Send';
  sendBtn.onclick = sendMessage;
  inputEl.focus();
  inputEl.focus();
}

