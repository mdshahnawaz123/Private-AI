<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>3D Review</title>
<style>
  :root{ --bg:#0b0f17; --panel:#131b26; --panel2:#1b2533; --border:#213042; --text:#eaf0f7; --muted:#8797ac; --accent:#4d7cfe; --mint:#31d0a5; --amber:#f5b73d; --red:#f2585f; }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,Arial,sans-serif;overflow:hidden;font-size:13px}
  #wrap{display:grid;grid-template-columns:230px 1fr 260px;grid-template-rows:48px 1fr;height:100vh}
  #bar{grid-column:1/4;display:flex;align-items:center;gap:6px;padding:0 12px;background:var(--panel);border-bottom:1px solid var(--border);overflow-x:auto;white-space:nowrap}
  .grp{display:inline-flex;align-items:center;gap:4px;padding:0 8px;border-right:1px solid var(--border);height:30px}
  .grp:last-child{border-right:none}
  .glbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-right:2px}
  button.tb{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:5px 9px;font-size:12px;cursor:pointer;font-family:inherit}
  button.tb:hover{border-color:var(--accent);color:#bcd0ff}
  button.tb.on{background:var(--accent);border-color:var(--accent);color:#fff}
  input[type=range]{width:90px}
  input[type=color]{width:26px;height:24px;border:1px solid var(--border);background:var(--panel2);border-radius:5px;padding:0;cursor:pointer}
  select.tb{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:4px 6px;font-size:12px;max-width:140px;font-family:inherit}
  #left{background:var(--panel);border-right:1px solid var(--border);overflow:auto;padding:12px}
  #right{background:var(--panel);border-left:1px solid var(--border);overflow:auto;padding:12px}
  #view{position:relative;overflow:hidden;background:radial-gradient(circle at 50% 30%, #14203100, #0a0e14)}
  #view canvas{display:block}
  .sec{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700;margin:4px 0 8px}
  .mrow{display:flex;align-items:center;gap:8px;padding:6px 8px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;background:var(--panel2)}
  .mrow input{accent-color:var(--accent)}
  .mname{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mdot{width:9px;height:9px;border-radius:50%}
  .prop{font-size:12px;margin-bottom:8px}
  .prop b{color:var(--muted);font-weight:600;display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em}
  .readout{background:var(--panel2);border:1px solid var(--border);border-radius:8px;padding:8px 10px;font-size:12px;margin-top:8px;min-height:24px}
  .catrow{display:flex;align-items:center;gap:6px;padding:4px 6px;border-radius:6px;font-size:12px;cursor:pointer;color:var(--muted)}
  .catrow:hover{background:var(--panel2);color:var(--text)}
  #loading{position:absolute;inset:0;display:grid;place-items:center;background:rgba(8,11,17,.85);z-index:5;font-size:14px;color:var(--muted)}
  #err{position:absolute;left:16px;right:16px;top:16px;background:#2a1420;border:1px solid var(--red);color:#ffd7db;border-radius:10px;padding:12px 14px;font-size:12.5px;display:none;z-index:6}
  .hint{color:var(--muted);font-size:11px;line-height:1.4;margin-top:8px}
</style>
</head>
<body>
<div id="wrap">
  <div id="bar">
    <div class="grp"><button class="tb" id="btnFit">Fit</button><button class="tb" id="btnReset">Reset</button></div>
    <div class="grp"><span class="glbl">Section</span>
      <button class="tb" data-ax="x">X</button><button class="tb" data-ax="y">Y</button><button class="tb" data-ax="z">Z</button>
      <button class="tb" id="secInvert">Flip</button><button class="tb" id="secOff">Off</button>
      <input type="range" id="secSlide" min="0" max="100" value="50">
    </div>
    <div class="grp"><span class="glbl">Visibility</span>
      <button class="tb" id="btnHide">Hide</button><button class="tb" id="btnIso">Isolate</button><button class="tb" id="btnShowAll">Show all</button>
    </div>
    <div class="grp"><span class="glbl">Color</span>
      <input type="color" id="colPick" value="#f5b73d">
      <button class="tb" id="btnColSel">Selection</button><button class="tb" id="btnColReset">Reset</button>
    </div>
    <div class="grp"><span class="glbl">Measure</span>
      <button class="tb" id="btnLen">Length</button><button class="tb" id="btnArea">Area</button><button class="tb" id="btnMclr">Clear</button>
    </div>
    <div class="grp"><span class="glbl">Plan</span>
      <select class="tb" id="storeySel"><option value="">3D view</option></select>
    </div>
  </div>

  <div id="left">
    <div class="sec">Models</div>
    <div id="modelList"></div>
    <div class="sec" style="margin-top:14px">Categories</div>
    <div id="catList"></div>
  </div>

  <div id="view">
    <div id="loading">Loading engine…</div>
    <div id="err"></div>
  </div>

  <div id="right">
    <div class="sec">Selection</div>
    <div id="propBox"><div class="hint">Click an element in the model to see its properties.</div></div>
    <div class="sec" style="margin-top:14px">Measurement</div>
    <div class="readout" id="measureOut">—</div>
    <div class="hint" id="modeHint"></div>
  </div>
</div>

<script type="importmap">
{ "imports": { "three": "/ui/vendor/three.module.js" } }
</script>
<script type="module" src="/ui/viewer.js"></script>
</body>
</html>
