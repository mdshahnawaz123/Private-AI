{
  "_meta": {
    "id": "architecture_concept",
    "name": "FLUX 3 Image Klein - Text to Image",
    "version": "3.0.0",
    "category": "concept",
    "description": "Local FLUX 3 Image Klein (distilled, int8) architectural concept rendering, 16 sampling steps.",
    "license_notes": "FLUX 3 Image Klein (5.6B, step-distilled, int8): FLUX Kommunity License - free commercial use only for individuals/organisations under US$5M annual revenue; larger organisations need a licence from Black Forest Labs. Text encoder qwen3vl_4b and flux2-vae under their own licences. Runs fully offline.",
    "parameters": [
      {
        "name": "prompt",
        "type": "string",
        "label": "Design Brief",
        "description": "Architectural program, form, facade materials, and context",
        "required": true
      },
      {
        "name": "width",
        "type": "integer",
        "label": "Width",
        "default": 1024,
        "min_value": 512,
        "max_value": 1024
      },
      {
        "name": "height",
        "type": "integer",
        "label": "Height",
        "default": 1024,
        "min_value": 512,
        "max_value": 1024
      },
      {
        "name": "seed",
        "type": "integer",
        "label": "Seed",
        "description": "Random seed for reproducible outputs",
        "default": null
      },
      {
        "name": "steps",
        "type": "integer",
        "label": "Steps",
        "default": 16,
        "min_value": 4,
        "max_value": 24,
        "description": "FLUX 3 Image Klein (distilled) sampling steps; 16 recommended"
      },
      {
        "name": "cfg",
        "type": "float",
        "label": "CFG Scale",
        "default": 1.0,
        "min_value": 1.0,
        "max_value": 1.0,
        "description": "Fixed at 1.0 for FLUX 3 Image Klein (distilled)"
      }
    ]
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux3-image-klein-int8-convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_int8_convrot.safetensors",
      "type": "flux3",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "Contemporary Dubai villa, warm limestone, shaded courtyard, golden hour, architectural photography"
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1024,
      "height": 768,
      "batch_size": 1
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ],
      "seed": 42,
      "steps": 16,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler (FLUX 3)"
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "Expo_Flux3_Klein"
    }
  }
}